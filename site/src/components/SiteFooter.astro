---
/* End matter, part two: a colophon. Black top rule, one baseline row — wordmark,
   links, copyright — then the house mark set oversized and cropped by the bottom
   of the page, the way a magazine ends on its own name. */
import type { SiteSettings } from '@/lib/sanity';
interface Props { settings: SiteSettings }
const { settings } = Astro.props;
const year = new Date().getFullYear();
const links = [
  ...(settings.footerColumns[0]?.items ?? []).filter((it) => Boolean(it.href)),
  ...(settings.instagram ? [{ label: 'Instagram', href: settings.instagram }] : []),
] as { label: string; href: string }[];
---
<footer class="ft">
  <div class="wrap">
    <div class="rule-black"></div>
    <div class="grid ft__top">
      <a class="ft__mark" href="/">Styling OC</a>
      <nav class="ft__links" aria-label="Footer">
        {links.map((it) => <a class="ft__link" href={it.href}>{it.label}</a>)}
      </nav>
      <p class="ft__note">© {year} Styling OC · Orange County, California</p>
    </div>
    <div class="rule"></div>
    <div class="ft__end">
      {settings.footerTagline && <p class="eyebrow eyebrow--muted ft__tagline">{settings.footerTagline}</p>}
      <div class="ft__big" aria-hidden="true">Styling OC</div>
    </div>
  </div>
</footer>

<style>
  .ft{background:var(--surface);margin-top:var(--section-y);overflow:hidden}
  .ft__top{align-items:baseline;padding:var(--space-6) 0;row-gap:var(--space-4)}
  .ft__mark{grid-column:1 / span 3;font-family:var(--font-display);font-weight:var(--weight-display);font-size:1.125rem;letter-spacing:.06em;text-transform:uppercase;line-height:1.2;color:var(--ink);text-decoration:none;border:0;justify-self:start}
  .ft__mark:hover{color:var(--accent-strong)}
  .ft__links{grid-column:4 / span 5;display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--space-4) var(--space-6)}
  /* The TextLink underline, kept local: label-width hairline, brass on hover. */
  .ft__link{position:relative;display:inline-block;font-family:var(--font-label);font-size:var(--text-label);font-weight:var(--weight-label);letter-spacing:var(--track-label);text-transform:uppercase;line-height:var(--leading-label);color:var(--ink);text-decoration:none;border:0;padding-bottom:5px;min-height:24px;transition:color var(--dur-base) var(--ease-editorial)}
  .ft__link::before,.ft__link::after{content:"";position:absolute;left:0;bottom:0;height:var(--hairline)}
  .ft__link::before{width:100%;background:currentColor;opacity:.24}
  .ft__link::after{width:0;background:var(--accent);transition:width var(--dur-base) var(--ease-rule)}
  .ft__link:hover::after,.ft__link:focus-visible::after{width:100%}
  .ft__link:hover{color:var(--accent-strong)}
  .ft__note{grid-column:9 / span 4;margin:0;text-align:right;font-family:var(--font-label);font-size:var(--text-label);letter-spacing:.1em;color:var(--ink-muted)}
  .ft__end{padding-top:var(--space-6)}
  .ft__tagline{margin:0 0 var(--space-4)}
  .ft__big{font-family:var(--font-display);font-weight:var(--weight-display);font-size:clamp(4rem,12vw,13rem);line-height:.85;letter-spacing:-.02em;color:var(--ink);white-space:nowrap;margin-bottom:-0.3em;user-select:none}
  @media (max-width:1024px){
    .ft__top{display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-4)}
    .ft__note{text-align:left}
  }
  @media (max-width:640px){
    .ft__links{gap:var(--space-3) var(--space-5)}
  }
</style>
