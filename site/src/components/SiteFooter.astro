---
/* End matter, part two: the masthead repeated to close the page. The wordmark set
   large on one centred line, the tagline beneath it, one centred row of small-caps
   links (the site navigation) and a single colophon line. One hairline opens it;
   no black rule, no cropped mark. */
import type { SiteSettings } from '@/lib/sanity';

interface Props { settings: SiteSettings }
const { settings } = Astro.props;
const year = new Date().getFullYear();
const place = settings.location || 'Orange County, California';
const links = [
  ...settings.nav.filter((l) => Boolean(l.href) && l.href !== '/#inquire'),
  ...(settings.instagram ? [{ label: 'Instagram', href: settings.instagram }] : []),
] as { label: string; href: string }[];
---
<footer class="ft">
  <div class="wrap">
    <div class="rule"></div>
    <div class="ft__stack">
      <a class="ft__mark" href="/" aria-label="Styling OC, home">Styling OC</a>
      {settings.footerTagline && <p class="ft__tagline">{settings.footerTagline}</p>}
      <nav class="ft__links" aria-label="Footer">
        {links.map((it) => <a class="ft__link" href={it.href}>{it.label}</a>)}
      </nav>
      <p class="ft__note">© {year} Styling OC · {place}{settings.email && <> · <a class="ft__email" href={`mailto:${settings.email}`}>{settings.email}</a></>}</p>
    </div>
  </div>
</footer>

<style>
  .ft{background:var(--surface)}
  .ft__stack{display:flex;flex-direction:column;align-items:center;text-align:center;padding-top:var(--space-7);padding-bottom:var(--space-8)}
  .ft__mark{font-family:var(--font-display);font-weight:var(--weight-display-strong);font-size:var(--text-display-l);line-height:1;letter-spacing:var(--track-display-wide);text-transform:uppercase;color:var(--ink);text-decoration:none;border:0;padding-left:.1em;white-space:nowrap;transition:color var(--dur-base) var(--ease-editorial)}
  .ft__mark:hover{color:var(--accent-strong)}
  .ft__tagline{margin:var(--space-4) 0 0;font-family:var(--font-label);font-size:var(--text-label);font-weight:var(--weight-label);letter-spacing:var(--track-label-wide);text-transform:uppercase;line-height:var(--leading-label);color:var(--ink);padding-left:.42em}
  .ft__links{margin-top:var(--space-6);display:flex;flex-wrap:wrap;justify-content:center;gap:var(--space-2) clamp(20px,3vw,44px)}
  /* The TextLink underline, kept local: label-width hairline, brass on hover. */
  .ft__link{position:relative;display:inline-block;font-family:var(--font-label);font-size:var(--text-label-l);font-weight:var(--weight-label);letter-spacing:var(--track-label);text-transform:uppercase;line-height:1.4;color:var(--ink);text-decoration:none;border:0;padding-bottom:5px;min-height:24px;transition:color var(--dur-base) var(--ease-editorial)}
  .ft__link::before,.ft__link::after{content:"";position:absolute;left:0;bottom:0;height:var(--hairline)}
  .ft__link::before{width:100%;background:currentColor;opacity:.24}
  .ft__link::after{width:0;background:var(--accent);transition:width var(--dur-base) var(--ease-rule)}
  .ft__link:hover::after,.ft__link:focus-visible::after{width:100%}
  .ft__link:hover{color:var(--accent-strong)}
  .ft__note{margin:var(--space-3) 0 0;font-family:var(--font-label);font-size:var(--text-label);font-weight:var(--weight-label);letter-spacing:.1em;text-transform:uppercase;line-height:var(--leading-label);color:var(--ink-muted)}
  .ft__email{color:inherit;text-decoration:none;border:0;transition:color var(--dur-base) var(--ease-editorial)}
  .ft__email:hover{color:var(--accent-strong)}
  @media (max-width:640px){
    .ft__mark{font-size:clamp(2rem,9vw,3rem)}
    .ft__links{gap:var(--space-2) var(--space-5)}
  }
</style>
