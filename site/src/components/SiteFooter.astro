---
/* End matter, part two: a full-bleed band that closes the page. It breaks out of the
   page gutters to the viewport edges under one hairline and reads as a single row:
   wordmark and tagline left, the small-caps site links centred, the colophon right.
   Below 640px it stacks and centres again. No black rule, no cropped mark. */
import type { SiteSettings } from '@/lib/sanity';
import { isLiveLink } from '@/lib/site';

interface Props { settings: SiteSettings }
const { settings } = Astro.props;
const year = new Date().getFullYear();
const place = settings.location || 'Orange County, California';
const links = [
  ...settings.nav.filter((l) => isLiveLink(l.href) && l.href !== '/#inquire'),
  ...(settings.instagram ? [{ label: 'Instagram', href: settings.instagram }] : []),
] as { label: string; href: string }[];
---
<footer class="ft">
  <div class="wrap">
    <div class="ft__stack">
      <div class="ft__lead">
        <a class="ft__mark" href="/" aria-label="Styling OC, home">Styling OC</a>
        {settings.footerTagline && <p class="ft__tagline">{settings.footerTagline}</p>}
      </div>
      <nav class="ft__links" aria-label="Footer">
        {links.map((it) => <a class="ft__link" href={it.href}>{it.label}</a>)}
      </nav>
      <p class="ft__note">© {year} Styling OC · {place}{settings.email && <> · <a class="ft__email" href={`mailto:${settings.email}`}>{settings.email}</a></>}</p>
    </div>
  </div>
</footer>

<style>
  .ft{background:var(--surface)}
  /* The band spans the viewport: negative gutters pull it past .wrap, the hairline is its own. */
  .ft__stack{margin-inline:calc(-1 * var(--gutter));border-top:var(--hairline) solid var(--rule);display:grid;grid-template-columns:1fr auto 1fr;align-items:end;column-gap:var(--space-6);text-align:left;padding:var(--space-6) var(--space-5)}
  .ft__lead{display:flex;flex-direction:column;align-items:flex-start}
  .ft__mark{font-family:var(--font-display);font-weight:var(--weight-display-strong);font-size:var(--text-display-m);line-height:1;letter-spacing:var(--track-display-wide);text-transform:uppercase;color:var(--ink);text-decoration:none;border:0;white-space:nowrap;transition:color var(--dur-base) var(--ease-editorial)}
  .ft__mark:hover{color:var(--accent-strong)}
  .ft__tagline{margin:var(--space-3) 0 0;font-family:var(--font-label);font-size:var(--text-label);font-weight:var(--weight-label);letter-spacing:var(--track-label-wide);text-transform:uppercase;line-height:var(--leading-label);color:var(--ink)}
  .ft__links{margin:0;align-self:end;display:flex;flex-wrap:wrap;justify-content:center;gap:var(--space-2) clamp(20px,3vw,44px)}
  /* The TextLink underline, kept local: label-width hairline, brass on hover. */
  .ft__link{position:relative;display:inline-block;font-family:var(--font-label);font-size:var(--text-label-l);font-weight:var(--weight-label);letter-spacing:var(--track-label);text-transform:uppercase;line-height:1.4;color:var(--ink);text-decoration:none;border:0;padding-bottom:5px;min-height:24px;transition:color var(--dur-base) var(--ease-editorial)}
  .ft__link::before,.ft__link::after{content:"";position:absolute;left:0;bottom:0;height:var(--hairline)}
  .ft__link::before{width:100%;background:currentColor;opacity:.24}
  .ft__link::after{width:0;background:var(--accent);transition:width var(--dur-base) var(--ease-rule)}
  .ft__link:hover::after,.ft__link:focus-visible::after{width:100%}
  .ft__link:hover{color:var(--accent-strong)}
  .ft__note{margin:0;align-self:end;text-align:right;font-family:var(--font-label);font-size:var(--text-label);font-weight:var(--weight-label);letter-spacing:.1em;text-transform:uppercase;line-height:var(--leading-label);color:var(--ink-muted)}
  /* The same hairline the nav links carry, so the address reads as a link at rest. */
  .ft__email{position:relative;display:inline-block;color:inherit;text-decoration:none;border:0;padding-bottom:2px;transition:color var(--dur-base) var(--ease-editorial)}
  .ft__email::before,.ft__email::after{content:"";position:absolute;left:0;bottom:0;height:var(--hairline)}
  .ft__email::before{width:100%;background:currentColor;opacity:.32}
  .ft__email::after{width:0;background:var(--accent);transition:width var(--dur-base) var(--ease-rule)}
  .ft__email:hover::after,.ft__email:focus-visible::after{width:100%}
  .ft__email:hover{color:var(--accent-strong)}
  @media (max-width:640px){
    .ft__stack{display:flex;flex-direction:column;align-items:center;text-align:center;padding:var(--space-7) var(--gutter) var(--space-8)}
    .ft__lead{align-items:center}
    .ft__mark{font-size:clamp(2rem,9vw,3rem)}
    .ft__links{margin-top:var(--space-6);gap:var(--space-2) var(--space-5)}
    .ft__note{margin-top:var(--space-3);text-align:center}
  }
</style>
