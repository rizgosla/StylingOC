---
/* Section opener (black rule, eyebrow, optional right-hand link) and up to three
   stories across, equal columns divided by hairlines drawn in the gaps so every
   plate is exactly the same width. */
import StoryCard from './StoryCard.astro';
import TextLink from './TextLink.astro';
import type { Post } from '@/lib/sanity';

interface Props { posts: Post[]; title: string; moreHref?: string; moreLabel?: string; numbered?: boolean; id?: string; headingLevel?: 'h2' | 'h3'; uniform?: boolean }
const { posts, title, moreHref, moreLabel = 'All stories', numbered = true, id, headingLevel = 'h3', uniform = false } = Astro.props;
---
<section class="wrap sg" id={id}>
  <div class="rule-black"></div>
  <div class="sg__head">
    <h2 class="eyebrow eyebrow--ink sg__title">{title}</h2>
    {moreHref && <TextLink href={moreHref}>{moreLabel}</TextLink>}
  </div>
  <ul class="sg__row" data-reveal-group>
    {posts.map((p, i) => (
      <li class="sg__cell reveal" style={`--i:${i}`}>
        <StoryCard post={p} index={numbered ? i : undefined} headingLevel={headingLevel} ratio={uniform ? '4:5' : undefined} />
      </li>
    ))}
  </ul>
</section>

<style>
  .sg{padding-top:var(--section-y-tight)}
  .sg__head{display:flex;align-items:baseline;justify-content:space-between;gap:var(--space-5);padding:var(--section-y-tight) 0 var(--space-6)}
  .sg__title{margin:0;font-size:var(--text-label);font-weight:400}
  .sg__row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:calc(var(--column-gap) * 2)}
  .sg__cell{position:relative;min-width:0;container-type:inline-size}
  .sg__cell + .sg__cell::before{content:"";position:absolute;top:0;bottom:0;left:calc(-1 * var(--column-gap));width:var(--hairline);background:var(--rule)}
  .reveal{transition-delay:calc(var(--i,0) * 90ms)}
  @media (max-width:1024px){
    .sg__row{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:var(--space-8)}
    .sg__cell:nth-child(3){grid-column:1 / -1;padding-top:var(--space-6);border-top:var(--hairline) solid var(--rule)}
    .sg__cell:nth-child(3)::before{display:none}
  }
  @media (max-width:640px){
    .sg__row{grid-template-columns:1fr;row-gap:var(--space-7)}
    .sg__cell::before{display:none}
    .sg__cell + .sg__cell{border-top:var(--hairline) solid var(--rule);padding-top:var(--space-6)}
  }
</style>
