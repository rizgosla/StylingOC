---
/* A photograph as the page's plate: square-cornered, full width of its column,
   with a tiny wide-tracked caption beneath. When there is no photograph yet the
   frame stays — paper ground, hairline, "Photograph to come" — so layouts can be
   judged before the client's photography arrives. Never carries text on top. */
import type { Img, Ratio } from '@/lib/sanity';
import { picture } from '@/lib/sanity';

interface Props {
  image: Img | null | undefined;
  ratio?: Ratio | 'natural';
  sizes?: string;
  caption?: boolean | string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
  class?: string;
  frameClass?: string;
  placeholder?: string;
  /** Clamp the frame's height; the image crops to cover. */
  maxHeight?: string;
  /** With `fit="height"` the frame keeps its ratio, takes `maxHeight` as its height and
      centres itself — for portrait leads that should not be cropped into a band. */
  fit?: 'width' | 'height';
}
const { image, ratio = 'natural', sizes = '100vw', caption = true, loading = 'lazy', fetchpriority = 'auto', class: cls = '', frameClass = '', placeholder = 'Photograph to come', maxHeight, fit = 'width' } = Astro.props;

const r = ratio === 'natural' ? (image ? `${image.width} / ${image.height}` : '4 / 5') : ratio.replace(':', ' / ');
const frameStyle = fit === 'height'
  ? `aspect-ratio:${r};height:${maxHeight ?? '80vh'};width:auto;max-width:100%;margin-inline:auto;`
  : `aspect-ratio:${r};${maxHeight ? `max-height:${maxHeight};` : ''}`;
const shot = image ? picture(image, ratio === 'natural' ? undefined : ratio) : null;
const captionText = typeof caption === 'string' ? caption : caption ? image?.caption : undefined;
---
<figure class:list={['plate', cls]}>
  <div class:list={['plate__frame', frameClass, { 'plate__frame--h': fit === 'height' }]} style={frameStyle}>
    {shot ? (
      <img
        src={shot.src}
        srcset={shot.srcset}
        sizes={shot.srcset ? sizes : undefined}
        width={shot.width}
        height={shot.height}
        alt={image!.alt}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
        style={shot.objectPosition ? `object-position:${shot.objectPosition}` : undefined}
      />
    ) : (
      <div class="plate__empty" role="img" aria-label={placeholder}>
        <span class="plate__empty-label" aria-hidden="true">{placeholder}</span>
      </div>
    )}
  </div>
  {captionText && <figcaption class="caption plate__caption">{captionText}</figcaption>}
</figure>

<style>
  .plate{margin:0}
  .plate__frame{position:relative;width:100%;overflow:hidden;background:var(--surface-sunken)}
  .plate__frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
  .plate__empty{position:absolute;inset:0;display:grid;place-items:center;background:var(--paper-100);box-shadow:inset 0 0 0 var(--hairline) var(--rule)}
  .plate__empty-label{font-family:var(--font-label);font-size:var(--text-label);letter-spacing:var(--track-label-wide);text-transform:uppercase;color:var(--ink-muted);padding:0 var(--space-4);text-align:center}
  .plate__caption{margin-top:var(--space-3)}
  .plate__frame--h + .plate__caption{text-align:center}
  @media (max-width:640px){.plate__frame--h{height:auto !important;width:100% !important}}
</style>
