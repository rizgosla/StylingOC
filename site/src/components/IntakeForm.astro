---
/* The inquiry intake. Four ruled parts — about you, what you are inquiring about,
   the details for the chosen service line, and a message — with underline-only
   fields, real labels, and one filled brass submit. Posts to the Cloudflare
   function without JavaScript; the script only hides the fieldsets that do not
   apply and shows the thank-you / error state after the redirect. */
import Button from './Button.astro';
import type { HomePage } from '@/lib/sanity';

interface Props { home: HomePage }
const { home } = Astro.props;

const projectTypes = ['Consultation only', 'Full-service interior design', 'E-design (remote)', 'Turnkey — the whole home', 'A single room', 'Pre-listing or post-purchase, with a real-estate agent', 'Not sure yet'];
const budgets = ['Under $5,000', '$5,000 – $20,000', '$20,000 – $50,000', '$50,000 – $100,000', '$100,000 – $250,000', 'Over $250,000', 'Not sure yet'];
const timelines = ['As soon as possible', 'Within three months', 'Three to six months', 'Later this year', 'Just exploring'];
const experiences = ['The Style Edit — $500 per hour', 'The Concierge — $5,000', 'The Image Experience — $10,000', 'Not sure yet'];
const sources = ['A friend or client', 'Instagram', 'A real-estate agent', 'Search', 'Press or the journal', 'Other'];
---
<form class="in" method="post" action="/api/inquiry" data-intake novalidate>
  <p class="in__status in__status--sent" role="status" tabindex="-1" hidden data-sent>
    <span class="display-m">Thank you.</span>
    <span class="body">Your inquiry has reached us. We read every answer ourselves and will reply personally within two business days.</span>
  </p>
  <p class="in__status in__status--error" role="alert" tabindex="-1" hidden data-error>
    <span class="body">Something went wrong and your inquiry did not send. Please check the required fields and try again.</span>
  </p>

  <div class="in__parts" data-parts>
    <fieldset class="in__part">
      <legend class="in__legend"><span class="numeral" aria-hidden="true">01</span><span class="display-s">About you</span></legend>
      <div class="in__fields">
        <div class="in__field">
          <label for="in-name" class="eyebrow eyebrow--muted">Name <span class="in__req" aria-hidden="true">*</span></label>
          <input id="in-name" name="name" type="text" autocomplete="name" required maxlength="120" />
        </div>
        <div class="in__field">
          <label for="in-email" class="eyebrow eyebrow--muted">Email <span class="in__req" aria-hidden="true">*</span></label>
          <input id="in-email" name="email" type="email" autocomplete="email" required maxlength="200" />
        </div>
        <div class="in__field">
          <label for="in-phone" class="eyebrow eyebrow--muted">Phone</label>
          <input id="in-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
        </div>
        <div class="in__field">
          <label for="in-city" class="eyebrow eyebrow--muted">City or neighbourhood</label>
          <input id="in-city" name="city" type="text" autocomplete="address-level2" maxlength="120" placeholder="" />
        </div>
      </div>
    </fieldset>

    <fieldset class="in__part">
      <legend class="in__legend"><span class="numeral" aria-hidden="true">02</span><span class="display-s">What you are inquiring about</span></legend>
      <div class="in__radios" role="radiogroup" aria-label="Service">
        {['Interior design', 'Personal styling', 'Both'].map((v, i) => (
          <label class="in__radio">
            <input type="radio" name="service" value={v} checked={i === 0} data-service />
            <span class="in__radio-mark" aria-hidden="true"></span>
            <span class="label">{v}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="in__part" data-part="interiors">
      <legend class="in__legend"><span class="numeral" aria-hidden="true">03</span><span class="display-s">The space</span></legend>
      <div class="in__fields">
        <div class="in__field">
          <label for="in-project" class="eyebrow eyebrow--muted">Project type</label>
          <select id="in-project" name="projectType">{projectTypes.map((v) => <option>{v}</option>)}</select>
        </div>
        <div class="in__field">
          <label for="in-budget" class="eyebrow eyebrow--muted">Budget</label>
          <select id="in-budget" name="budget">{budgets.map((v) => <option>{v}</option>)}</select>
        </div>
        <div class="in__field in__field--wide">
          <label for="in-scope" class="eyebrow eyebrow--muted">Rooms or scope</label>
          <input id="in-scope" name="scope" type="text" maxlength="300" />
          <span class="in__hint body-s">For example: living room and primary bedroom; a full remodel of a 3,200 sq ft home; staging before listing.</span>
        </div>
      </div>
    </fieldset>

    <fieldset class="in__part" data-part="styling" hidden>
      <legend class="in__legend"><span class="numeral" aria-hidden="true">03</span><span class="display-s">Your style</span></legend>
      <div class="in__fields">
        <div class="in__field">
          <label for="in-experience" class="eyebrow eyebrow--muted">Experience</label>
          <select id="in-experience" name="experience">{experiences.map((v) => <option>{v}</option>)}</select>
        </div>
        <div class="in__field in__field--wide">
          <label for="in-goals" class="eyebrow eyebrow--muted">Occasion or goals</label>
          <input id="in-goals" name="goals" type="text" maxlength="300" />
          <span class="in__hint body-s">A new role, a season of change, an event, or simply a wardrobe that works.</span>
        </div>
      </div>
    </fieldset>

    <fieldset class="in__part">
      <legend class="in__legend"><span class="numeral" aria-hidden="true">04</span><span class="display-s">Tell us more</span></legend>
      <div class="in__fields">
        <div class="in__field">
          <label for="in-timeline" class="eyebrow eyebrow--muted">Timeline</label>
          <select id="in-timeline" name="timeline">{timelines.map((v) => <option>{v}</option>)}</select>
        </div>
        <div class="in__field">
          <label for="in-source" class="eyebrow eyebrow--muted">How did you hear about us</label>
          <select id="in-source" name="source">{sources.map((v) => <option>{v}</option>)}</select>
        </div>
        <div class="in__field in__field--wide">
          <label for="in-message" class="eyebrow eyebrow--muted">Anything else we should know <span class="in__req" aria-hidden="true">*</span></label>
          <textarea id="in-message" name="message" rows="5" required maxlength="4000"></textarea>
        </div>
        <div class="in__hp" aria-hidden="true">
          <label for="in-company">Company</label>
          <input id="in-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
      </div>
    </fieldset>

    <div class="in__actions">
      <Button type="submit" variant="accent" size="lg">Send the inquiry</Button>
      {home.inquiryNote && <span class="eyebrow eyebrow--muted">{home.inquiryNote}</span>}
    </div>
  </div>
</form>

<style>
  .in{display:block}
  .in__parts{display:flex;flex-direction:column}
  .in__part{border:0;margin:0;padding:var(--space-7) 0 var(--space-8);border-top:var(--hairline) solid var(--rule);min-width:0}
  .in__part:first-child{border-top:0;padding-top:var(--space-2)}
  .in__part[hidden]{display:none}
  /* Floating the legend pulls it into the fieldset's content, so the top rule stays a clean line above it. */
  .in__legend{float:left;width:100%;display:flex;align-items:baseline;gap:var(--space-4);padding:0;margin-bottom:var(--space-6);color:var(--ink)}
  .in__fields,.in__radios{clear:both}
  .in__fields{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-7) var(--column-gap)}
  .in__field{display:flex;flex-direction:column;gap:var(--space-2);min-width:0}
  .in__field--wide{grid-column:1 / -1}
  .in__req{color:var(--accent-strong)}
  .in__hint{margin-top:var(--space-2)}
  .in__field input,.in__field select,.in__field textarea{width:100%;min-height:44px;border:0;border-bottom:var(--hairline) solid var(--rule-strong);background:transparent;padding:10px 0;color:var(--ink);font-family:var(--font-body);font-weight:var(--weight-body);font-size:var(--text-body);line-height:1.5;transition:border-color var(--dur-base) var(--ease-editorial)}
  .in__field textarea{resize:vertical;min-height:120px}
  .in__field select{appearance:none;-webkit-appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--ink) 50%),linear-gradient(135deg,var(--ink) 50%,transparent 50%);background-position:calc(100% - 9px) 55%,calc(100% - 4px) 55%;background-size:5px 5px;background-repeat:no-repeat;padding-right:24px;cursor:pointer}
  .in__field input:focus,.in__field select:focus,.in__field textarea:focus{outline:none;border-bottom-color:var(--accent-strong)}
  .in__field input:focus-visible,.in__field select:focus-visible,.in__field textarea:focus-visible{outline:var(--hairline) solid var(--focus-ring);outline-offset:3px}
  .in__field [aria-invalid="true"]{border-bottom-color:var(--accent-strong)}
  /* Radios drawn as hairline squares — no rounded controls in this system. */
  .in__radios{display:flex;flex-wrap:wrap;gap:var(--space-4) var(--space-8)}
  .in__radio{position:relative;display:inline-flex;align-items:center;gap:var(--space-3);min-height:44px;cursor:pointer;color:var(--ink)}
  .in__radio input{position:absolute;opacity:0;width:1px;height:1px}
  .in__radio-mark{width:16px;height:16px;border:var(--hairline) solid var(--rule-strong);display:inline-grid;place-items:center;transition:border-color var(--dur-base) var(--ease-editorial)}
  .in__radio-mark::after{content:"";width:8px;height:8px;background:var(--ink);transform:scale(0);transition:transform var(--dur-fast) var(--ease-editorial)}
  .in__radio input:checked + .in__radio-mark{border-color:var(--ink)}
  .in__radio input:checked + .in__radio-mark::after{transform:none}
  .in__radio input:focus-visible + .in__radio-mark{outline:var(--hairline) solid var(--focus-ring);outline-offset:3px}
  .in__hp{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
  .in__actions{display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-6);padding-top:var(--space-4)}
  .in__status{margin:0 0 var(--space-7);display:flex;flex-direction:column;gap:var(--space-3);padding:var(--space-6) 0;border-top:var(--hairline) solid var(--rule-black);border-bottom:var(--hairline) solid var(--rule)}
  .in__status--error{border-top-color:var(--accent-strong)}
  .in__status[hidden],.in__parts[hidden]{display:none}
  .in__status:focus{outline:none}
  .in__status .body{max-width:52ch}
  @media (max-width:640px){
    .in__fields{grid-template-columns:1fr}
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-intake]');
  if (form) {
    // Show only the fieldset for the chosen service line (both when "Both").
    const radios = Array.from(form.querySelectorAll<HTMLInputElement>('[data-service]'));
    const parts = { interiors: form.querySelector<HTMLElement>('[data-part="interiors"]')!, styling: form.querySelector<HTMLElement>('[data-part="styling"]')! };
    const sync = () => {
      const v = radios.find((r) => r.checked)?.value ?? 'Interior design';
      parts.interiors.hidden = v === 'Personal styling';
      parts.styling.hidden = v === 'Interior design';
    };
    radios.forEach((r) => r.addEventListener('change', sync));
    sync();

    // Thank-you / error state after the function's redirect.
    const state = new URLSearchParams(location.search).get('inquiry');
    const sent = form.querySelector<HTMLElement>('[data-sent]');
    const error = form.querySelector<HTMLElement>('[data-error]');
    if (state === 'sent' && sent) { sent.hidden = false; form.querySelector<HTMLElement>('[data-parts]')!.hidden = true; sent.scrollIntoView({ block: 'center' }); sent.focus({ preventScroll: true }); }
    if (state === 'error' && error) { error.hidden = false; error.scrollIntoView({ block: 'center' }); error.focus({ preventScroll: true }); }

    form.addEventListener('submit', (e) => {
      const invalid = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')).filter((el) => !el.checkValidity());
      if (invalid.length) {
        e.preventDefault();
        if (error) { error.hidden = false; }
        invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
        invalid[0].focus();
      }
    });
    form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute('aria-invalid'));
  }
</script>
