---
/* The interiors menu as a pinned horizontal spread. The section is taller than the
   screen; a full-height frame sticks while the page scrolls, and that vertical scroll
   drives the row sideways (a CSS scroll-driven animation; a small script does the same
   where the browser lacks it). The heading and introduction are the first panel; each
   package is a panel behind a full-height hairline: a large thin numeral, the plate,
   the title and the price in full. Panels alternate between two heights.
   Below 1025px, and under prefers-reduced-motion, it is an ordinary sideways-scrolling
   row instead of a pinned one. */
import Plate from './Plate.astro';
import TextLink from './TextLink.astro';
import type { ServicePackage } from '@/lib/sanity';

interface Props { id: string; eyebrow: string; headline: string; intro: string; packages: ServicePackage[] }
const { id, eyebrow, headline, intro, packages } = Astro.props;
const ratios = ['4:5', '3:4'] as const;
---
<section class="col" id={id} aria-labelledby={`${id}-title`} data-collage style={`--n:${packages.length}`}>
  <div class="col__pin">
    <div class="col__frame">
      <ol class="col__track" tabindex="0" aria-label="Interior design packages; scroll to move sideways">
        <li class="col__panel col__panel--intro">
          <div class="col__introin">
            <p class="eyebrow">{eyebrow}</p>
            <h2 id={`${id}-title`} class="display-m col__title">{headline}</h2>
            <p class="body col__lede">{intro}</p>
            <TextLink href="/#inquire">Begin an inquiry</TextLink>
            <p class="eyebrow eyebrow--muted col__hint" aria-hidden="true">Scroll <span class="col__arrow">→</span></p>
          </div>
        </li>
        {packages.map((p, i) => (
          <li class:list={['col__panel', i % 2 ? 'col__panel--high' : 'col__panel--low']}>
            <span class="col__num" aria-hidden="true">{p.numeral}</span>
            <div class="col__plate">
              <Plate image={p.image ?? null} ratio={ratios[i % 2]} sizes="(max-width: 1024px) 60vw, 19vw" caption={false} />
            </div>
            <h3 class="col__name">{p.title}</h3>
            <p class="col__price"><span class="label">{p.price}</span>{p.priceNote && <span class="col__pn">{p.priceNote}</span>}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  /* Geometry shared by both modes: the intro panel and the package panels have fixed
     viewport widths so the row's length — and therefore the pinned scroll distance —
     is known in CSS: intro 34vw + n × 24vw. */
  /* The panel geometry is derived from the story grid above, so the vertical hairlines run
     in one straight line from the stories down through the menu: the intro panel ends on the
     grid's first divider and every package panel spans exactly one grid column plus its gaps.
     100cqw is the section's own width (the scrollbar already excluded). */
  .col{--sgcol:calc((100cqw - 2 * var(--gutter) - 4 * var(--column-gap)) / 3);--intro-w:calc(var(--gutter) + var(--sgcol) + var(--column-gap));--panel-w:calc(var(--sgcol) + 2 * var(--column-gap));--bar:64px;container-type:inline-size;position:relative;scroll-margin-top:0}
  /* The row starts on the page's left gutter and runs off the right edge of the screen. */
  .col__track{display:flex;align-items:stretch;margin:0;padding:0;width:max-content}
  .col__panel{flex:0 0 var(--panel-w);width:var(--panel-w);display:flex;flex-direction:column;gap:var(--space-4);padding:0 clamp(20px,2.4vw,44px);border-left:var(--hairline) solid var(--rule);min-width:0}
  .col__panel--intro{flex-basis:var(--intro-w);width:var(--intro-w);border-left:0;padding-left:var(--gutter);padding-right:clamp(32px,4vw,80px);justify-content:center}
  .col__introin{display:flex;flex-direction:column;gap:var(--space-5);max-width:40ch}
  .eyebrow{margin:0}
  .col__title{margin:0;max-width:14ch;text-wrap:balance}
  .col__lede{margin:0}
  .col__hint{margin-top:var(--space-8)}
  .col__arrow{display:inline-block;margin-left:.4em}
  .col__num{font-family:var(--font-display);font-weight:300;font-size:clamp(2.5rem,4.8vw,5.75rem);line-height:.9;letter-spacing:-.02em;color:var(--accent);margin:0 0 var(--space-3)}
  .col__plate{width:100%}
  .col__name{margin:var(--space-3) 0 0;font-family:var(--font-display);font-weight:var(--weight-display);font-size:var(--text-title);line-height:var(--leading-title);letter-spacing:var(--track-display);color:var(--ink);max-width:20ch;text-wrap:balance}
  .col__price{margin:0;display:flex;flex-direction:column;gap:2px;color:var(--ink)}
  .col__pn{font-size:0.75rem;line-height:1.5;color:var(--ink-muted);max-width:26ch}

  /* Pinned mode (wide screens, motion allowed). */
  @media (min-width:1025px) and (prefers-reduced-motion:no-preference){
    .col__pin{height:calc(var(--intro-w) + var(--n) * var(--panel-w) - 100cqw + 100vh)}
    .col__frame{position:sticky;top:0;height:100vh;overflow:hidden;border-top:var(--hairline) solid var(--rule-black);border-bottom:var(--hairline) solid var(--rule)}
    .col__track{height:100vh;will-change:transform}
    /* Content sits around the vertical centre of the frame whatever the window height;
       the stagger comes from asymmetric padding, so short windows have no dead band. */
    .col__panel{justify-content:center;padding-top:var(--bar);padding-bottom:4vh}
    .col__panel--high{padding-bottom:14vh}
    .col__panel--low{padding-top:calc(var(--bar) + 14vh)}
    .col__track:focus-visible{outline:var(--hairline) solid var(--focus-ring);outline-offset:-6px}
  }

  /* Row mode (narrow screens, or reduced motion): native sideways scroll. */
  @media (max-width:1024px), (prefers-reduced-motion:reduce){
    .col{padding-block:var(--section-y-tight)}
    .col__pin{border-top:0}
    .col__frame{overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x proximity;scrollbar-width:none;-webkit-overflow-scrolling:touch}
    .col__frame::-webkit-scrollbar{display:none}
    .col__track{padding-top:var(--space-7);padding-right:var(--gutter);padding-bottom:var(--space-8)}
    .col__panel{scroll-snap-align:start;padding-top:var(--space-4)}
    .col__panel--low{padding-top:clamp(40px,8vw,96px)}
    .col__panel{--panel-w:clamp(280px,42vw,400px)}
    .col__panel--intro{--intro-w:min(88vw,480px);padding-left:var(--gutter);justify-content:flex-start}
    .col__hint{display:none}
  }
  @media (max-width:640px){
    .col__panel{--panel-w:68vw !important}
    .col__panel--intro{--intro-w:88vw;flex-basis:88vw;width:88vw}
    .col__panel--low{padding-top:var(--space-7)}
  }
</style>

<!-- Kept out of the CSS pipeline on purpose: the minifier folds these longhands into an
     animation shorthand with a timeline inside it, which browsers reject. -->
<style is:inline>
  @keyframes soc-collage-slide { from { transform: translateX(0); } to { transform: translateX(calc(100cqw - 100%)); } }
  @supports (animation-timeline: view()) {
    @media (min-width: 1025px) and (prefers-reduced-motion: no-preference) {
      .col__pin { view-timeline-name: --soc-collage; view-timeline-axis: block; }
      .col__track {
        animation-name: soc-collage-slide;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-duration: auto;
        animation-timeline: --soc-collage;
        animation-range: contain 0% contain 100%;
      }
    }
  }
</style>

<script>
  /* Fallback for browsers without scroll-driven animations: same maths, from scroll position. */
  if (!CSS.supports('animation-timeline: view()')) {
    document.querySelectorAll<HTMLElement>('[data-collage]').forEach((root) => {
      const pin = root.querySelector<HTMLElement>('.col__pin')!;
      const track = root.querySelector<HTMLElement>('.col__track')!;
      const pinned = () => matchMedia('(min-width: 1025px) and (prefers-reduced-motion: no-preference)').matches;
      let ticking = false;
      const update = () => {
        ticking = false;
        if (!pinned()) { track.style.transform = ''; return; }
        const rect = pin.getBoundingClientRect();
        const distance = pin.offsetHeight - innerHeight;
        const progress = Math.min(1, Math.max(0, -rect.top / Math.max(1, distance)));
        track.style.transform = `translateX(${-progress * (track.scrollWidth - root.clientWidth)}px)`;
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll);
      update();
    });
  }
</script>
