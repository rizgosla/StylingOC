---
/* Oversized brass quotation mark, Zodiak italic 300, first-name attribution after a
   short rule. `inline` is the compact form used inside a Journal body. */
interface Props { quote: string; attribution: string; role?: string; size?: 'sm' | 'md' | 'lg'; inline?: boolean; class?: string }
const { quote, attribution, role, size = 'lg', inline = false, class: cls = '' } = Astro.props;
---
{inline ? (
  <figure class:list={['pq', 'pq--inline', `pq--${size}`, cls]}>
    <span class="pq__mark" aria-hidden="true">&ldquo;</span>
    <blockquote class="pq__q"><p>{quote}</p></blockquote>
    <figcaption class="pq__by"><span class="pq__rule" aria-hidden="true"></span><span class="eyebrow eyebrow--muted">{attribution}{role ? ` · ${role}` : ''}</span></figcaption>
  </figure>
) : (
  <section class:list={['wrap', 'section', cls]} aria-label={`Testimonial from ${attribution}`}>
    <div class="grid">
      <figure class:list={['pq', `pq--${size}`, 'reveal']}>
        <span class="pq__mark" aria-hidden="true">&ldquo;</span>
        <blockquote class="pq__q"><p>{quote}</p></blockquote>
        <figcaption class="pq__by"><span class="pq__rule" aria-hidden="true"></span><span class="eyebrow eyebrow--muted">{attribution}{role ? ` · ${role}` : ''}</span></figcaption>
      </figure>
    </div>
  </section>
)}

<style>
  .pq{grid-column:2 / span 8;margin:0}
  .pq--inline{margin:var(--space-8) 0}
  .pq__mark{display:block;font-family:var(--font-display);font-size:5.5rem;line-height:.6;color:var(--accent);opacity:.75;margin-bottom:var(--space-6)}
  .pq--inline .pq__mark{font-size:4rem;margin-bottom:var(--space-5)}
  .pq__q{margin:0}
  .pq__q p{margin:0;font-family:var(--font-editorial);font-style:italic;font-weight:300;line-height:1.34;letter-spacing:.005em;color:var(--ink);max-width:30ch;text-wrap:pretty}
  .pq--lg .pq__q p{font-size:var(--text-display-m)}
  .pq--md .pq__q p{font-size:var(--text-display-s);max-width:34ch}
  .pq--sm .pq__q p{font-size:var(--text-title);max-width:40ch}
  .pq__by{margin-top:var(--space-6);display:flex;align-items:center;gap:var(--space-4)}
  .pq__rule{width:40px;height:var(--hairline);background:var(--rule-strong)}
  @media (max-width:1024px){.pq{grid-column:1 / span 7}}
  @media (max-width:640px){.pq{grid-column:1 / -1}}
</style>
