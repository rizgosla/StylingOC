---
/* One service line as its own section: a headline row, then a ruled bento grid.
   Every package is an equal cell; the photograph is a cell that spans two rows, so
   the grid stays asymmetrical without any cell looking short-changed. Cells sit on
   the paper-50 ground, divided by hairlines (a gap the rule colour shows through);
   nothing is a box with a radius or a shadow. The evening consultation cell is set in
   the night theme — the one dark moment the brand allows. */
import Plate from './Plate.astro';
import TextLink from './TextLink.astro';
import type { Img, ServicePackage } from '@/lib/sanity';

interface Props {
  id: string;
  eyebrow: string;
  headline: string;
  intro: string;
  image: Img | null;
  packages: ServicePackage[];
  flip?: boolean;
}
const { id, eyebrow, headline, intro, image, packages, flip = false } = Astro.props;
const layout = packages.length >= 6 ? 'six' : 'three';
const isNight = (p: ServicePackage) => /evening/i.test(p.title);
---
<section class:list={['wrap', 'svc', { 'svc--flip': flip }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="rule-black"></div>
  <header class="grid svc__head">
    <div class="svc__intro">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`} class="display-l svc__title">{headline}</h2>
    </div>
    <div class="svc__lede">
      <p class="body">{intro}</p>
      <TextLink href="/inquire/">Begin an inquiry</TextLink>
    </div>
  </header>

  <ol class:list={['bento', `bento--${layout}`]}>
    <li class="bento__cell bento__cell--img reveal" aria-hidden="true">
      <Plate image={image} ratio="4:5" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 100vw, 40vw" caption={false} frameClass="bento__frame" />
    </li>
    {packages.map((p, i) => (
      <li class:list={['bento__cell', 'reveal', { 'bento__cell--night': isNight(p) }]} style={`--i:${i + 1}`} data-theme={isNight(p) ? 'night' : undefined}>
        <div class="bento__top">
          <span class="numeral" aria-hidden="true">{p.numeral}</span>
          {p.image ? (
            <div class="bento__thumb"><Plate image={p.image} ratio="4:5" sizes="96px" caption={false} /></div>
          ) : isNight(p) ? (
            <span class="bento__moon" aria-hidden="true">☾</span>
          ) : null}
        </div>
        <h3 class="display-s bento__title">{p.title}</h3>
        <ul class="bento__items">
          {p.items.map((it) => <li class="body-s">{it}</li>)}
        </ul>
        {p.note && <p class="bento__note">{p.note}</p>}
        <div class="bento__price">
          <span class="label">{p.price}</span>
          {p.priceNote && <span class="bento__pn">{p.priceNote}</span>}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .svc{padding-top:var(--section-y);padding-bottom:var(--section-y)}
  .svc__head{padding:var(--space-6) 0 var(--space-9);align-items:end}
  .svc__intro{grid-column:1 / span 7;display:flex;flex-direction:column;gap:var(--space-4)}
  .svc__lede{grid-column:9 / span 4;display:flex;flex-direction:column;gap:var(--space-5);padding-bottom:var(--space-2)}
  .svc__lede .body{margin:0;max-width:42ch}
  .eyebrow{margin:0}
  .svc__title{margin:0;max-width:14ch;text-wrap:balance}

  /* The ruled grid: a 1px gap with the rule colour behind it draws every divider at once. */
  .bento{display:grid;gap:var(--hairline);background:var(--rule);border:var(--hairline) solid var(--rule);grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:minmax(300px,auto)}
  .bento__cell{background:var(--surface-raised);padding:clamp(24px,2.4vw,40px);display:flex;flex-direction:column;gap:var(--space-5);min-width:0;transition-delay:calc(var(--i,0) * 70ms)}
  .bento__cell--img{padding:0;background:var(--surface-sunken)}
  .bento__cell--img :global(.plate),.bento__cell--img :global(.plate__frame){height:100%}
  .bento__cell--img :global(.bento__frame){aspect-ratio:auto !important;min-height:100%}
  .bento__top{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--space-4)}
  .bento__thumb{width:clamp(64px,6vw,96px);flex:none}
  .bento__moon{font-family:var(--font-display);font-size:1.75rem;line-height:1;color:var(--accent)}
  .bento__title{margin:0;max-width:16ch}
  .bento__items{display:flex;flex-direction:column;gap:var(--space-2);max-width:44ch}
  .bento__items li{margin:0}
  .bento__note{margin:0;font-family:var(--font-editorial);font-style:italic;font-weight:300;font-size:var(--text-body);line-height:1.5;color:var(--ink-muted);max-width:40ch}
  .bento__price{margin-top:auto;padding-top:var(--space-5);display:flex;flex-direction:column;gap:var(--space-1);color:var(--ink);border-top:var(--hairline) solid var(--rule)}
  .bento__pn{font-size:var(--text-body-s);line-height:1.5;color:var(--ink-muted);max-width:30ch}

  /* Six packages: image spans two rows of the first two columns; the last two cells go wide. */
  .bento--six .bento__cell--img{grid-column:1 / span 2;grid-row:1 / span 2}
  .bento--six .bento__cell:nth-child(6),.bento--six .bento__cell:nth-child(7){grid-column:span 2}
  .svc--flip .bento--six .bento__cell--img{grid-column:3 / span 2}
  .svc--flip .bento--six .bento__cell:nth-child(2){grid-column:1}
  .svc--flip .bento--six .bento__cell:nth-child(3){grid-column:2}
  /* Three packages: image spans two rows of the first two columns; the top tier goes wide. */
  .bento--three .bento__cell--img{grid-column:1 / span 2;grid-row:1 / span 2}
  .bento--three .bento__cell:nth-child(4){grid-column:span 2}
  .svc--flip .bento--three .bento__cell--img{grid-column:3 / span 2}
  .svc--flip .bento--three .bento__cell:nth-child(2){grid-column:1;grid-row:1}
  .svc--flip .bento--three .bento__cell:nth-child(3){grid-column:2;grid-row:1}
  .svc--flip .bento--three .bento__cell:nth-child(4){grid-column:1 / span 2;grid-row:2}

  /* Night cell: the dark editorial spread, warm paper ink, brass lifted. */
  .bento__cell--night{--surface:#141414;--surface-raised:#141414;--ink:#F5F3EF;--ink-muted:#B5B0A8;--rule:rgba(245,243,239,.22);--accent:#C2A164;--accent-strong:#D8BC85;background:#141414;color:var(--ink)}
  .bento__cell--night .bento__title,.bento__cell--night .bento__price{color:var(--ink)}
  .bento__cell--night .bento__price{border-top-color:var(--rule)}

  @media (max-width:1024px){
    .svc__intro{grid-column:1 / span 5}
    .svc__lede{grid-column:6 / span 3}
    .bento,.svc--flip .bento{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:auto}
    .bento .bento__cell,.svc--flip .bento .bento__cell{grid-column:auto;grid-row:auto}
    .bento .bento__cell--img,.svc--flip .bento .bento__cell--img{grid-column:1 / span 2;grid-row:auto;min-height:0}
    .bento__cell--img :global(.bento__frame){aspect-ratio:3 / 2 !important;min-height:0}
    .bento--six .bento__cell:nth-child(6),.bento--six .bento__cell:nth-child(7),.bento--three .bento__cell:nth-child(4){grid-column:span 1}
  }
  @media (max-width:640px){
    .svc__intro,.svc__lede{grid-column:1 / -1}
    .bento,.svc--flip .bento{grid-template-columns:minmax(0,1fr)}
    .bento .bento__cell--img,.svc--flip .bento .bento__cell--img{grid-column:1}
    .bento__cell--img :global(.bento__frame){aspect-ratio:4 / 5 !important}
  }
</style>
