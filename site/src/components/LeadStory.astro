---
/* The front-page lead. Tall plate on the left, headline block bottom-aligned beside it,
   all on white. On wide screens a rail of three equal photographs from other stories
   runs down the right edge, sharing the plate's height. */
import Plate from './Plate.astro';
import TextLink from './TextLink.astro';
import type { Img, Post } from '@/lib/sanity';
import { kicker } from '@/lib/sanity';

interface Props { post: Post; rail?: Img[]; headline?: string; eyebrow?: string }
const { post, rail = [], headline, eyebrow } = Astro.props;
const title = headline?.trim() || post.title;
const label = eyebrow?.trim() || kicker(post);
const href = `/journal/${post.slug}/`;
const railImages = rail.filter((i) => i && i.src !== post.leadImage?.src).filter((i, n, a) => a.findIndex((x) => x.src === i.src) === n).slice(0, 3);
---
<section class="wrap lead" aria-labelledby="lead-title">
  <div class="grid lead__grid">
    <a class="lead__img" href={href} tabindex="-1" aria-hidden="true">
      <Plate image={post.leadImage} ratio="4:5" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 62vw, 50vw" loading="eager" fetchpriority="high" />
    </a>
    <div class="lead__text">
      <p class="eyebrow">{label}</p>
      <h1 id="lead-title" class="display-l lead__title"><a href={href} class="lead__link">{title}</a></h1>
      <p class="standfirst lead__standfirst">{post.standfirst}</p>
      <TextLink href={href}>Read the story</TextLink>
    </div>
    {railImages.length >= 2 && (
      <div class="lead__rail" aria-hidden="true">
        <div class="lead__rail-track">
          {railImages.map((img) => (
            <div class="lead__rail-item">
              <Plate image={img} ratio="3:4" sizes="14vw" caption={false} />
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .lead{padding-top:clamp(20px,2.6vw,36px)}
  .lead__grid{align-items:end}
  .lead__img{grid-column:1 / span 6;display:block;border:0;text-decoration:none}
  .lead__text{grid-column:7 / span 6;display:flex;flex-direction:column;gap:var(--space-5);padding-bottom:var(--space-6);padding-left:var(--space-4)}
  .lead__title{margin:0;text-wrap:balance;font-size:clamp(2.75rem,5.6vw,7rem);line-height:1.02}
  .lead__link{color:var(--ink);text-decoration:none;border:0;transition:color var(--dur-base) var(--ease-editorial)}
  .lead__link:hover{color:var(--ink-700)}
  .lead__standfirst{margin:0;max-width:46ch;font-size:var(--text-lede)}
  .eyebrow{margin:0}
  .lead__rail{display:none}

  /* Only on wide screens, where the six-column headline block would otherwise float in air:
     the headline narrows to four columns and the rail takes the last two. */
  @media (min-width:1680px){
    .lead__img{grid-column:1 / span 5}
    .lead__text{grid-column:6 / span 5}
    .lead__title{font-size:clamp(3rem,4.9vw,6.5rem)}
    .lead__rail{display:block;grid-column:11 / span 2;align-self:stretch;position:relative;overflow:hidden;border-left:var(--hairline) solid var(--rule);padding-left:var(--grid-gap)}
    /* Three equal thumbnails share the column's height: each row is a third, the plate keeps
       its 3:4 ratio inside it, so all three are the same size and none is cut off. */
    .lead__rail-track{position:absolute;inset:0 0 0 calc(var(--grid-gap) + var(--hairline));display:grid;grid-template-rows:repeat(3,minmax(0,1fr));gap:var(--grid-gap)}
    .lead__rail-item{min-height:0;display:flex;align-items:start}
    .lead__rail-item :global(.plate){height:100%;margin:0;max-width:100%}
    .lead__rail-item :global(.plate__frame){height:100%;width:auto;max-width:100%;aspect-ratio:3 / 4}
  }

  @media (max-width:1024px){
    .lead__img{grid-column:1 / span 5}
    .lead__text{grid-column:6 / span 3;padding-left:0}
  }
  @media (max-width:640px){
    .lead__img,.lead__text{grid-column:1 / -1}
    .lead__text{padding:var(--space-2) 0 0}
    .lead__title{max-width:none}
  }
</style>
