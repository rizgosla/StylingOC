---
/* The front-page lead. Tall plate on the left, headline block bottom-aligned on the
   right, all on white. The first thing a reader sees, so the image loads eagerly. */
import Plate from './Plate.astro';
import TextLink from './TextLink.astro';
import type { Post } from '@/lib/sanity';
import { kicker } from '@/lib/sanity';

interface Props { post: Post }
const { post } = Astro.props;
const href = `/journal/${post.slug}/`;
---
<section class="wrap lead" aria-labelledby="lead-title">
  <div class="grid lead__grid">
    <a class="lead__img" href={href} tabindex="-1" aria-hidden="true">
      <Plate image={post.leadImage} ratio="4:5" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 62vw, 56vw" loading="eager" fetchpriority="high" maxHeight="84vh" />
    </a>
    <div class="lead__text">
      <p class="eyebrow">{kicker(post)}</p>
      <h1 id="lead-title" class="display-l lead__title"><a href={href} class="lead__link">{post.title}</a></h1>
      <p class="standfirst lead__standfirst">{post.standfirst}</p>
      <TextLink href={href}>Read the story</TextLink>
    </div>
  </div>
</section>

<style>
  .lead{padding-top:clamp(20px,2.6vw,36px)}
  .lead__grid{align-items:end}
  .lead__img{grid-column:1 / span 7;display:block;border:0;text-decoration:none}
  .lead__text{grid-column:8 / span 5;display:flex;flex-direction:column;gap:var(--space-5);padding-bottom:var(--space-6);padding-left:var(--space-4)}
  .lead__title{margin:0;max-width:14ch;text-wrap:balance;font-size:clamp(2.5rem,4.6vw,4.5rem)}
  .lead__link{color:var(--ink);text-decoration:none;border:0;transition:color var(--dur-base) var(--ease-editorial)}
  .lead__link:hover{color:var(--ink-700)}
  .lead__standfirst{margin:0;max-width:40ch}
  .eyebrow{margin:0}
  @media (max-width:1024px){
    .lead__img{grid-column:1 / span 5}
    .lead__text{grid-column:6 / span 3;padding-left:0}
  }
  @media (max-width:640px){
    .lead__img,.lead__text{grid-column:1 / -1}
    .lead__text{padding:var(--space-2) 0 0}
    .lead__title{max-width:none}
  }
</style>
