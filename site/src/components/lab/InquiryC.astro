---
/* Variant C2 — "Sign-off", part one: the inquiry compressed into a single ruled
   strip. A small serif headline holds the left three columns; the fields run as a
   one-line coupon across the rest, with Send on the input baseline. Phone and
   interest live in a <details> beneath, opposite the reply note. Posts to the same
   Cloudflare function as the real form; same field names, same status script. */
import TextLink from '../TextLink.astro';
import type { HomePage } from '@/lib/sanity';

interface Props { home: HomePage; email?: string; phone?: string }
const { home, email, phone } = Astro.props;
---
<section class="wrap iq" id="inquire" aria-labelledby="iq-title">
  <div class="rule"></div>
  <form class="grid iq__grid" method="post" action="/api/inquiry" data-inquiry novalidate>
    <div class="iq__intro">
      <p class="eyebrow">{home.inquiryEyebrow}</p>
      <h2 id="iq-title" class="display-s iq__title">{home.inquiryHeadline}</h2>
      {(email || phone) && (
        <p class="body-s iq__write">
          {email && <>Or write to <TextLink href={`mailto:${email}`} caps={false}>{email}</TextLink></>}
          {email && phone && <> · </>}
          {phone && <>{email ? 'or call ' : 'Or call '}<TextLink href={`tel:${phone.replace(/[^\d+]/g, '')}`} caps={false}>{phone}</TextLink></>}
        </p>
      )}
    </div>
    <p class="iq__status iq__status--sent" role="status" tabindex="-1" hidden data-sent>
      <span class="display-s">Thank you.</span>
      <span class="body-s">Your inquiry has reached us. We will reply personally within two business days.</span>
    </p>
    <p class="iq__status iq__status--error" role="alert" tabindex="-1" hidden data-error>
      <span class="body-s">Something went wrong and your message did not send. Please check your name, email and message and try again.</span>
    </p>
    <div class="iq__fields">
      <div class="iq__field iq__field--name">
        <label for="iq-name" class="eyebrow eyebrow--muted">Name <span class="iq__req" aria-hidden="true">*</span></label>
        <input id="iq-name" name="name" type="text" autocomplete="name" required maxlength="120" />
      </div>
      <div class="iq__field iq__field--email">
        <label for="iq-email" class="eyebrow eyebrow--muted">Email <span class="iq__req" aria-hidden="true">*</span></label>
        <input id="iq-email" name="email" type="email" autocomplete="email" required maxlength="200" />
      </div>
      <div class="iq__field iq__field--message">
        <label for="iq-message" class="eyebrow eyebrow--muted">Tell us about the project <span class="iq__req" aria-hidden="true">*</span></label>
        <textarea id="iq-message" name="message" rows="1" required maxlength="4000"></textarea>
      </div>
      <button type="submit" class="iq__submit"><span class="iq__submit-label">Send</span></button>
      <div class="iq__hp" aria-hidden="true">
        <label for="iq-company">Company</label>
        <input id="iq-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>
    <div class="iq__actions">
      <details class="iq__more">
        <summary class="iq__summary"><span class="iq__sign" aria-hidden="true"></span><span class="iq__summary-label">More about the project</span></summary>
        <div class="iq__more-fields">
          <div class="iq__field iq__field--phone">
            <label for="iq-phone" class="eyebrow eyebrow--muted">Phone</label>
            <input id="iq-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
          </div>
          <div class="iq__field iq__field--interest">
            <label for="iq-interest" class="eyebrow eyebrow--muted">I am interested in</label>
            <select id="iq-interest" name="interest">
              <option>Interior design</option>
              <option>Personal styling</option>
              <option>Both</option>
            </select>
          </div>
        </div>
      </details>
      {home.inquiryNote && <span class="eyebrow eyebrow--muted iq__note">{home.inquiryNote}</span>}
    </div>
  </form>
</section>

<style>
  .iq{scroll-margin-top:72px}
  .iq__grid{padding-top:var(--space-7);align-items:start;row-gap:var(--space-5)}
  .iq__intro{grid-column:1 / span 3;grid-row:1 / span 2;display:flex;flex-direction:column;gap:var(--space-3)}
  .eyebrow{margin:0}
  .iq__title{margin:0;max-width:14ch}
  .iq__write{color:var(--ink-muted)}
  .iq__fields{grid-column:4 / span 9;display:grid;grid-template-columns:repeat(9,minmax(0,1fr));column-gap:var(--grid-gap);row-gap:var(--space-5);align-items:end}
  .iq__field{display:flex;flex-direction:column;gap:var(--space-2)}
  .iq__field--name{grid-column:1 / span 2}
  .iq__field--email{grid-column:3 / span 2}
  .iq__field--message{grid-column:5 / span 4}
  .iq__field label{display:block}
  .iq__req{color:var(--accent-strong)}
  .iq__field input,.iq__field select,.iq__field textarea{width:100%;min-height:44px;border:0;border-bottom:var(--hairline) solid var(--rule-strong);background:transparent;padding:10px 0;color:var(--ink);font-family:var(--font-body);font-weight:var(--weight-body);font-size:var(--text-body);line-height:1.5;transition:border-color var(--dur-base) var(--ease-editorial)}
  /* One row deep, growing with the text where field-sizing is supported and
     scrolling where it is not; never taller than four lines. */
  .iq__field textarea{min-height:44px;max-height:176px;field-sizing:content;resize:none;overflow:auto}
  .iq__field select{appearance:none;-webkit-appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--ink) 50%),linear-gradient(135deg,var(--ink) 50%,transparent 50%);background-position:calc(100% - 9px) 55%,calc(100% - 4px) 55%;background-size:5px 5px;background-repeat:no-repeat;padding-right:24px;cursor:pointer}
  .iq__field input:focus,.iq__field select:focus,.iq__field textarea:focus{outline:none;border-bottom-color:var(--accent-strong)}
  .iq__field input:focus-visible,.iq__field select:focus-visible,.iq__field textarea:focus-visible{outline:var(--hairline) solid var(--focus-ring);outline-offset:3px}
  .iq__hp{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
  /* The TextLink underline, on a real button: no fill, no border, no padding. */
  /* The label sits on the inputs' baseline: its hairline lands on their bottom rule. */
  .iq__submit{grid-column:9 / span 1;justify-self:end;align-self:end;display:inline-flex;align-items:flex-end;border:0;background:none;padding:0;margin:0;min-height:44px;color:var(--ink);cursor:pointer;transition:color var(--dur-base) var(--ease-editorial)}
  .iq__submit-label{position:relative;display:inline-block;padding-bottom:5px;font-family:var(--font-label);font-size:var(--text-label-l);font-weight:var(--weight-label);letter-spacing:var(--track-label);text-transform:uppercase;line-height:1.4}
  .iq__submit-label::before,.iq__submit-label::after{content:"";position:absolute;left:0;bottom:0;height:var(--hairline)}
  .iq__submit-label::before{width:100%;background:currentColor;opacity:.24}
  .iq__submit-label::after{width:0;background:var(--accent);transition:width var(--dur-base) var(--ease-rule)}
  .iq__submit:hover .iq__submit-label::after,.iq__submit:focus-visible .iq__submit-label::after{width:100%}
  .iq__submit:hover{color:var(--accent-strong)}
  /* Summary and note share one grid cell: the note sits right, the disclosure opens beneath. */
  .iq__actions{grid-column:4 / span 9;display:grid;grid-template-columns:repeat(9,minmax(0,1fr));column-gap:var(--grid-gap);align-items:start}
  .iq__more{grid-row:1;grid-column:1 / -1}
  .iq__summary{display:inline-flex;align-items:center;gap:var(--space-3);min-height:44px;list-style:none;cursor:pointer;color:var(--ink);transition:color var(--dur-base) var(--ease-editorial)}
  .iq__summary::-webkit-details-marker{display:none}
  .iq__summary:hover{color:var(--accent-strong)}
  .iq__sign{color:var(--accent-strong);font-family:var(--font-label);font-size:var(--text-label-l);line-height:1.4;padding-bottom:5px}
  .iq__sign::before{content:"+"}
  /* En dash, not U+2212: Archivo has it, so the open state keeps the same font. */
  .iq__more[open] .iq__sign::before{content:"\2013"}
  .iq__summary-label{position:relative;display:inline-block;padding-bottom:5px;font-family:var(--font-label);font-size:var(--text-label-l);font-weight:var(--weight-label);letter-spacing:var(--track-label);text-transform:uppercase;line-height:1.4}
  .iq__summary-label::before,.iq__summary-label::after{content:"";position:absolute;left:0;bottom:0;height:var(--hairline)}
  .iq__summary-label::before{width:100%;background:currentColor;opacity:.24}
  .iq__summary-label::after{width:0;background:var(--accent);transition:width var(--dur-base) var(--ease-rule)}
  .iq__summary:hover .iq__summary-label::after,.iq__summary:focus-visible .iq__summary-label::after{width:100%}
  .iq__more-fields{margin-top:var(--space-5);display:grid;grid-template-columns:repeat(9,minmax(0,1fr));column-gap:var(--grid-gap);row-gap:var(--space-5)}
  .iq__field--phone{grid-column:1 / span 4}
  .iq__field--interest{grid-column:5 / span 4}
  .iq__note{grid-row:1;grid-column:1 / -1;justify-self:end;display:inline-flex;align-items:center;min-height:44px;margin:0}
  .iq__status{grid-column:4 / span 9;margin:0;display:flex;flex-direction:column;gap:var(--space-2);padding:var(--space-5) 0;border-top:var(--hairline) solid var(--rule-strong);border-bottom:var(--hairline) solid var(--rule)}
  .iq__status--error{border-top-color:var(--accent-strong)}
  .iq__status:focus{outline:none}
  .iq__status[hidden],.iq__fields[hidden],.iq__actions[hidden]{display:none}
  @media (max-width:1024px){
    .iq__intro{grid-column:1 / span 8;grid-row:auto}
    .iq__fields,.iq__actions,.iq__status{grid-column:1 / span 8}
    .iq__fields{grid-template-columns:repeat(8,minmax(0,1fr))}
    .iq__field--name{grid-column:1 / span 4}
    .iq__field--email{grid-column:5 / span 4}
    .iq__field--message{grid-column:1 / span 6}
    .iq__submit{grid-column:7 / span 2}
    .iq__actions{grid-template-columns:repeat(8,minmax(0,1fr))}
    .iq__more-fields{grid-template-columns:repeat(8,minmax(0,1fr))}
    .iq__field--interest{grid-column:5 / span 4}
  }
  @media (max-width:640px){
    .iq__intro,.iq__fields,.iq__actions,.iq__status{grid-column:1 / -1}
    .iq__fields,.iq__actions,.iq__more-fields{grid-template-columns:minmax(0,1fr)}
    .iq__field--name,.iq__field--email,.iq__field--message,.iq__field--phone,.iq__field--interest,.iq__submit{grid-column:1 / -1}
    .iq__submit{justify-self:start}
    .iq__more,.iq__note{grid-row:auto;grid-column:1 / -1;justify-self:start}
    .iq__actions{row-gap:var(--space-3)}
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-inquiry]');
  if (form) {
    const state = new URLSearchParams(location.search).get('inquiry');
    const sent = form.querySelector<HTMLElement>('[data-sent]');
    const error = form.querySelector<HTMLElement>('[data-error]');
    if (state === 'sent' && sent) { sent.hidden = false; form.querySelector<HTMLElement>('.iq__fields')!.hidden = true; form.querySelector<HTMLElement>('.iq__actions')!.hidden = true; sent.scrollIntoView({ block: 'center' }); sent.focus({ preventScroll: true }); }
    if (state === 'error' && error) { error.hidden = false; error.scrollIntoView({ block: 'center' }); error.focus({ preventScroll: true }); }
    // Client-side validation with real messages; the function validates again.
    form.addEventListener('submit', (e) => {
      const invalid = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')).filter((el) => !el.checkValidity());
      if (invalid.length) {
        e.preventDefault();
        if (error) { error.hidden = false; }
        invalid[0].focus();
        invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
      }
    });
    form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute('aria-invalid'));
  }
</script>
