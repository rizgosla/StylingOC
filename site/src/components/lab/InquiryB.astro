---
/* Lab variant B2 — "Closing masthead", part one. The headline runs across the top,
   then a narrow single-column coupon on the left (name, email, message, a details
   disclosure holding phone and interest, send) with a small contact directory
   aside on the right. No rule opens the section; the only hairline in the pair
   sits between this form and the footer. Same field names, hooks, honeypot and
   status script as the live InquiryForm, so the winner can replace it by swap. */
import TextLink from '../TextLink.astro';
import type { HomePage } from '@/lib/sanity';

interface Props { home: HomePage; email?: string; phone?: string }
const { home, email, phone } = Astro.props;
const hasAside = Boolean(email || phone);
---
<section class="wrap iq" id="inquire" aria-labelledby="iq-title">
  <div class="grid iq__grid">
    <div class="iq__head">
      <p class="eyebrow">{home.inquiryEyebrow}</p>
      <h2 id="iq-title" class="display-m iq__title">{home.inquiryHeadline}</h2>
      {home.inquiryIntro && <p class="italic iq__lede">{home.inquiryIntro}</p>}
    </div>
    <form class="iq__form" method="post" action="/api/inquiry" data-inquiry novalidate>
      <p class="iq__status iq__status--sent" role="status" tabindex="-1" hidden data-sent>
        <span class="display-s">Thank you.</span>
        <span class="body-s">Your inquiry has reached us. We will reply personally within two business days.</span>
      </p>
      <p class="iq__status iq__status--error" role="alert" tabindex="-1" hidden data-error>
        <span class="body-s">Something went wrong and your message did not send. Please check your name, email and message and try again.</span>
      </p>
      <div class="iq__fields">
        <div class="iq__field">
          <label for="iq-name" class="eyebrow eyebrow--muted">Name <span class="iq__req" aria-hidden="true">*</span></label>
          <input id="iq-name" name="name" type="text" autocomplete="name" required maxlength="120" />
        </div>
        <div class="iq__field">
          <label for="iq-email" class="eyebrow eyebrow--muted">Email <span class="iq__req" aria-hidden="true">*</span></label>
          <input id="iq-email" name="email" type="email" autocomplete="email" required maxlength="200" />
        </div>
        <div class="iq__field">
          <label for="iq-message" class="eyebrow eyebrow--muted">Tell us about the project <span class="iq__req" aria-hidden="true">*</span></label>
          <textarea id="iq-message" name="message" rows="3" required maxlength="4000"></textarea>
        </div>
        <details class="iq__more">
          <summary class="iq__summary"><span class="iq__plus" aria-hidden="true"></span><span class="iq__sum-label">More about the project</span></summary>
          <div class="iq__more-in">
            <div class="iq__field">
              <label for="iq-phone" class="eyebrow eyebrow--muted">Phone</label>
              <input id="iq-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
            </div>
            <div class="iq__field">
              <label for="iq-interest" class="eyebrow eyebrow--muted">I am interested in</label>
              <select id="iq-interest" name="interest">
                <option>Interior design</option>
                <option>Personal styling</option>
                <option>Both</option>
              </select>
            </div>
          </div>
        </details>
        <div class="iq__hp" aria-hidden="true">
          <label for="iq-company">Company</label>
          <input id="iq-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
      </div>
      <div class="iq__actions">
        <button type="submit" class="iq__submit"><span class="iq__submit-label">Send inquiry</span></button>
        {!hasAside && home.inquiryNote && <span class="body-s iq__note">{home.inquiryNote}</span>}
      </div>
    </form>
    {hasAside && (
      <aside class="iq__aside" aria-label="Contact the studio">
        {email && (
          <div class="iq__stack">
            <p class="eyebrow eyebrow--muted">Write</p>
            <TextLink href={`mailto:${email}`} caps={false} class="iq__value">{email}</TextLink>
          </div>
        )}
        {phone && (
          <div class="iq__stack">
            <p class="eyebrow eyebrow--muted">Call</p>
            <TextLink href={`tel:${phone.replace(/[^\d+]/g, '')}`} caps={false} class="iq__value">{phone}</TextLink>
          </div>
        )}
        {home.inquiryNote && <p class="body-s iq__note">{home.inquiryNote}</p>}
      </aside>
    )}
  </div>
</section>

<style>
  .iq{scroll-margin-top:72px;padding-top:var(--space-7);padding-bottom:var(--space-8)}
  .iq__grid{row-gap:var(--space-7);align-items:start}
  .iq__head{grid-column:1 / span 7}
  .eyebrow{margin:0}
  /* 16ch in the sketch would break this headline over two lines; 26ch is the widest
     the seeded line needs and still holds it on one at 1440 and 1900. */
  .iq__title{margin:var(--space-4) 0 0;max-width:26ch;text-wrap:balance}
  .iq__lede{margin:var(--space-3) 0 0;font-size:var(--text-title);line-height:1.4;color:var(--ink)}
  .iq__form{grid-column:1 / span 5;max-width:520px}
  .iq__fields{display:flex;flex-direction:column;gap:var(--space-6)}
  .iq__field{display:flex;flex-direction:column;gap:var(--space-2)}
  .iq__field label{display:block}
  .iq__req{color:var(--accent-strong)}
  .iq__field input,.iq__field select,.iq__field textarea{width:100%;min-height:44px;border:0;border-bottom:var(--hairline) solid var(--rule-strong);background:transparent;padding:10px 0;color:var(--ink);font-family:var(--font-body);font-weight:var(--weight-body);font-size:var(--text-body);line-height:1.5;transition:border-color var(--dur-base) var(--ease-editorial)}
  .iq__field textarea{resize:vertical;min-height:74px}
  .iq__field select{appearance:none;-webkit-appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--ink) 50%),linear-gradient(135deg,var(--ink) 50%,transparent 50%);background-position:calc(100% - 9px) 55%,calc(100% - 4px) 55%;background-size:5px 5px;background-repeat:no-repeat;padding-right:24px;cursor:pointer}
  .iq__field input:focus,.iq__field select:focus,.iq__field textarea:focus{outline:none;border-bottom-color:var(--accent-strong)}
  .iq__field input:focus-visible,.iq__field select:focus-visible,.iq__field textarea:focus-visible{outline:var(--hairline) solid var(--focus-ring);outline-offset:3px}
  /* The disclosure: a text link with a brass operator, never a button-shaped object. */
  .iq__more{margin:0}
  .iq__summary{display:inline-flex;align-items:center;gap:var(--space-3);min-height:44px;list-style:none;cursor:pointer;color:var(--ink);transition:color var(--dur-base) var(--ease-editorial)}
  .iq__summary::-webkit-details-marker{display:none}
  .iq__summary:hover{color:var(--accent-strong)}
  .iq__plus{color:var(--accent-strong);font-family:var(--font-label);font-size:var(--text-label-l);line-height:1}
  .iq__plus::before{content:"+"}
  .iq__more[open] .iq__plus::before{content:"\2212"}
  .iq__sum-label{position:relative;display:inline-block;padding-bottom:5px;font-family:var(--font-label);font-size:var(--text-label-l);font-weight:var(--weight-label);letter-spacing:var(--track-label);text-transform:uppercase;line-height:1.4}
  .iq__sum-label::before,.iq__sum-label::after{content:"";position:absolute;left:0;bottom:0;height:var(--hairline)}
  .iq__sum-label::before{width:100%;background:currentColor;opacity:.24}
  .iq__sum-label::after{width:0;background:var(--accent);transition:width var(--dur-base) var(--ease-rule)}
  .iq__summary:hover .iq__sum-label::after,.iq__summary:focus-visible .iq__sum-label::after{width:100%}
  .iq__more-in{margin-top:var(--space-5);display:flex;flex-direction:column;gap:var(--space-6)}
  .iq__hp{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
  .iq__actions{margin-top:var(--space-6);display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--space-4) var(--space-6)}
  .iq__note{margin:0;color:var(--ink-muted)}
  /* The TextLink underline, on a real button: no fill, no border, no padding. */
  .iq__submit{display:inline-flex;align-items:center;border:0;background:none;padding:0;margin:0;min-height:44px;color:var(--ink);cursor:pointer;transition:color var(--dur-base) var(--ease-editorial)}
  .iq__submit-label{position:relative;display:inline-block;padding-bottom:5px;font-family:var(--font-label);font-size:var(--text-label-l);font-weight:var(--weight-label);letter-spacing:var(--track-label);text-transform:uppercase;line-height:1.4}
  .iq__submit-label::before,.iq__submit-label::after{content:"";position:absolute;left:0;bottom:0;height:var(--hairline)}
  .iq__submit-label::before{width:100%;background:currentColor;opacity:.24}
  .iq__submit-label::after{width:0;background:var(--accent);transition:width var(--dur-base) var(--ease-rule)}
  .iq__submit:hover .iq__submit-label::after,.iq__submit:focus-visible .iq__submit-label::after{width:100%}
  .iq__submit:hover{color:var(--accent-strong)}
  .iq__aside{grid-column:7 / span 4;align-self:start;display:flex;flex-direction:column;gap:var(--space-5)}
  .iq__stack{display:flex;flex-direction:column;gap:var(--space-2)}
  .iq__stack p{margin:0}
  .iq__value{font-size:var(--text-body);line-height:1.5}
  .iq__status{margin:0 0 var(--space-6);display:flex;flex-direction:column;gap:var(--space-2);padding:var(--space-5) 0;border-top:var(--hairline) solid var(--rule-strong);border-bottom:var(--hairline) solid var(--rule)}
  .iq__status--error{border-top-color:var(--accent-strong)}
  .iq__status:focus{outline:none}
  .iq__status[hidden],.iq__fields[hidden],.iq__actions[hidden]{display:none}
  @media (max-width:1024px){
    .iq__head{grid-column:1 / span 8}
    .iq__form{grid-column:1 / span 5}
    .iq__aside{grid-column:6 / span 3}
  }
  @media (max-width:640px){
    .iq__head,.iq__form,.iq__aside{grid-column:1 / -1;max-width:none}
    .iq__aside{order:2}
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-inquiry]');
  if (form) {
    const state = new URLSearchParams(location.search).get('inquiry');
    const sent = form.querySelector<HTMLElement>('[data-sent]');
    const error = form.querySelector<HTMLElement>('[data-error]');
    if (state === 'sent' && sent) { sent.hidden = false; form.querySelector<HTMLElement>('.iq__fields')!.hidden = true; form.querySelector<HTMLElement>('.iq__actions')!.hidden = true; sent.scrollIntoView({ block: 'center' }); sent.focus({ preventScroll: true }); }
    if (state === 'error' && error) { error.hidden = false; error.scrollIntoView({ block: 'center' }); error.focus({ preventScroll: true }); }
    // Client-side validation with real messages; the function validates again.
    form.addEventListener('submit', (e) => {
      const invalid = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')).filter((el) => !el.checkValidity());
      if (invalid.length) {
        e.preventDefault();
        if (error) { error.hidden = false; }
        invalid[0].focus();
        invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
      }
    });
    form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute('aria-invalid'));
  }
</script>
