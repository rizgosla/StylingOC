---
/* Variant C2 — "Sign-off", part two: no rule, no cropped mark. The tagline is set
   as a three-line display-serif statement, one sentence per line, the last one in
   italic brass — the statement is the mark. A single colophon line closes the page,
   its right edge landing on the same column as the statement's. */
import type { SiteSettings } from '@/lib/sanity';

interface Props { settings: SiteSettings }
const { settings } = Astro.props;
const year = new Date().getFullYear();
const place = settings.location || 'Orange County, California';
/* Which part of the statement takes the brass italic: the closing sentence, or
   only its last word. Flip to 'word' to try the tighter reading. */
const BRASS: 'sentence' | 'word' = 'sentence';
const sentences = (settings.footerTagline || '').split(/(?<=\.)\s+/).filter(Boolean);
const last = sentences.length - 1;
const links = [
  ...settings.nav.filter((l) => l.href !== '/#inquire'),
  ...(settings.instagram ? [{ label: 'Instagram', href: settings.instagram }] : []),
];
---
<footer class="wrap ft">
  {sentences.length > 0 && (
    <div class="grid">
      <p class="ft__statement">
        {sentences.map((s, i) => (
          i === last
            ? (BRASS === 'sentence'
                ? <span class="ft__line"><span class="ft__brass">{s}</span></span>
                : <span class="ft__line">{s.replace(/\s*\S+$/, '')} <span class="ft__brass">{s.match(/\S+$/)?.[0]}</span></span>)
            : <span class="ft__line">{s}</span>
        ))}
      </p>
    </div>
  )}
  <div class="grid ft__colophon">
    <a class="ft__mark" href="/">Styling OC</a>
    <nav class="ft__links" aria-label="Footer">
      {links.map((it) => <a class="ft__link" href={it.href}>{it.label}</a>)}
    </nav>
    <p class="ft__note">© {year} · {place}</p>
  </div>
</footer>

<style>
  .ft{background:var(--surface);margin-top:var(--space-9)}
  .ft__statement{grid-column:1 / span 10;margin:0;max-width:20ch;font-family:var(--font-display);font-weight:var(--weight-display);font-size:var(--text-display-l);line-height:var(--leading-display-loose);letter-spacing:var(--track-display);color:var(--ink)}
  .ft__line{display:block}
  .ft__brass{font-family:var(--font-editorial);font-style:italic;font-weight:300;color:var(--accent-strong)}
  .ft__colophon{margin-top:var(--space-8);padding-bottom:var(--space-8);align-items:baseline;row-gap:var(--space-4)}
  /* The compact bar's wordmark, reused: the statement above is the big mark. */
  .ft__mark{grid-column:1 / span 2;justify-self:start;font-family:var(--font-display);font-weight:var(--weight-display-strong);font-size:1rem;letter-spacing:var(--track-display-wide);text-transform:uppercase;line-height:1;color:var(--ink);text-decoration:none;border:0;white-space:nowrap}
  .ft__mark:hover{color:var(--accent-strong)}
  /* 16px, not 28: at 1440 the five columns hold the four links on one line only at this gap. */
  .ft__links{grid-column:3 / span 5;display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--space-3) var(--space-4)}
  /* The TextLink underline, kept local: label-width hairline, brass on hover. */
  .ft__link{position:relative;display:inline-block;font-family:var(--font-label);font-size:var(--text-label-l);font-weight:var(--weight-label);letter-spacing:var(--track-label);text-transform:uppercase;line-height:var(--leading-label);color:var(--ink);text-decoration:none;border:0;padding-bottom:5px;transition:color var(--dur-base) var(--ease-editorial)}
  .ft__link::before,.ft__link::after{content:"";position:absolute;left:0;bottom:0;height:var(--hairline)}
  .ft__link::before{width:100%;background:currentColor;opacity:.24}
  .ft__link::after{width:0;background:var(--accent);transition:width var(--dur-base) var(--ease-rule)}
  .ft__link:hover::after,.ft__link:focus-visible::after{width:100%}
  .ft__link:hover{color:var(--accent-strong)}
  .ft__note{grid-column:8 / span 3;margin:0;text-align:right;font-family:var(--font-label);font-size:var(--text-label);font-weight:var(--weight-label);letter-spacing:.1em;text-transform:uppercase;line-height:var(--leading-label);color:var(--ink-muted)}
  @media (max-width:1024px){
    .ft{margin-top:var(--space-8)}
    .ft__statement{grid-column:1 / span 8}
    .ft__mark{grid-column:1 / span 2}
    .ft__links{grid-column:3 / span 4}
    .ft__note{grid-column:7 / span 2}
  }
  @media (max-width:640px){
    /* Full width and the display-l floor: each sentence takes two lines on a phone,
       which reads better than dropping the sign-off to a smaller size. */
    .ft__statement{grid-column:1 / -1;max-width:none}
    .ft__colophon{display:flex;flex-direction:column;align-items:flex-start;gap:var(--space-3)}
    .ft__note{text-align:left}
  }
</style>
