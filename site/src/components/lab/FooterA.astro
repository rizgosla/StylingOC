---
/* Lab variant A2 — "Colophon, set tight", row two. The footer is the second row of
   the same spread: wordmark and links under the headline column, the studio
   statement and copyright under the form column. One hairline, no cropped mark. */
import type { SiteSettings } from '@/lib/sanity';
interface Props { settings: SiteSettings }
const { settings } = Astro.props;
const year = new Date().getFullYear();
const place = settings.location || 'Orange County, California';
const links = [
  ...(settings.nav ?? []).filter((it) => Boolean(it.href) && it.href !== '/#inquire'),
  ...(settings.instagram ? [{ label: 'Instagram', href: settings.instagram }] : []),
] as { label: string; href: string }[];
---
<footer class="ft">
  <div class="wrap">
    <div class="rule"></div>
    <div class="grid ft__grid">
      <div class="ft__id">
        <a class="ft__mark" href="/" aria-label="Styling OC, home">Styling OC</a>
        <nav class="ft__links" aria-label="Footer">
          {links.map((it) => <a class="ft__link" href={it.href}>{it.label}</a>)}
        </nav>
      </div>
      <div class="ft__say">
        {settings.footerTagline && <p class="italic ft__statement">{settings.footerTagline}</p>}
        <p class="ft__copy">© {year} Styling OC · {place}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .ft{background:var(--surface)}
  .ft__grid{padding-top:var(--space-7);padding-bottom:var(--space-8);align-items:start}
  .ft__id{grid-column:1 / span 4;display:flex;flex-direction:column}
  .ft__mark{font-family:var(--font-display);font-weight:var(--weight-display-strong);font-size:var(--text-display-s);letter-spacing:.1em;text-transform:uppercase;line-height:1;color:var(--ink);text-decoration:none;border:0;align-self:flex-start;margin:0 0 var(--space-4);transition:color var(--dur-base) var(--ease-editorial)}
  .ft__mark:hover{color:var(--accent-strong)}
  .ft__links{display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--space-2) var(--space-5)}
  /* The TextLink underline, kept local: label-width hairline, brass on hover. */
  .ft__link{position:relative;display:inline-block;font-family:var(--font-label);font-size:var(--text-label-l);font-weight:var(--weight-label);letter-spacing:var(--track-label);text-transform:uppercase;line-height:1.4;color:var(--ink);text-decoration:none;border:0;padding-bottom:5px;min-height:24px;transition:color var(--dur-base) var(--ease-editorial)}
  .ft__link::before,.ft__link::after{content:"";position:absolute;left:0;bottom:0;height:var(--hairline)}
  .ft__link::before{width:100%;background:currentColor;opacity:.24}
  .ft__link::after{width:0;background:var(--accent);transition:width var(--dur-base) var(--ease-rule)}
  .ft__link:hover::after,.ft__link:focus-visible::after{width:100%}
  .ft__link:hover{color:var(--accent-strong)}
  .ft__say{grid-column:6 / span 7;display:flex;flex-direction:column}
  .ft__statement{margin:0 0 var(--space-3);max-width:34ch;font-size:var(--text-title);line-height:1.5;color:var(--ink)}
  .ft__copy{margin:0;font-family:var(--font-label);font-size:var(--text-label);font-weight:var(--weight-label);letter-spacing:.1em;text-transform:uppercase;line-height:var(--leading-label);color:var(--ink-muted)}
  @media (max-width:1024px){
    .ft__id{grid-column:1 / span 3}
    .ft__say{grid-column:4 / span 5}
  }
  @media (max-width:640px){
    .ft__id,.ft__say{grid-column:1 / -1}
  }
</style>
