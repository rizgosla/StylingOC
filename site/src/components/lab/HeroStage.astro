---
/* Hero variant B — "The stage". One wide 16:9 plate in the middle of the page, three
   portrait plates down each side sharing its height, and the eyebrow and headline
   centred beneath the stage, one line. The wide frame is built to take a film later: pass `video`
   and a muted, looping <video> replaces the photograph, which stays as its poster.
   Six-up geometry: with c the stage width and g the grid gap, each side rail is
   (9c/16 − 2g)/3 tall and, at 3:4, 9c/64 − g/2 wide, so c = 32(W − g)/41 of the row. */
import Plate from '../Plate.astro';
import TextLink from '../TextLink.astro';
import type { Img, Post } from '@/lib/sanity';
import { kicker, picture } from '@/lib/sanity';
import { landscapeFirst, portraitFirst, unique } from './heroImages';

interface Props {
  post: Post; rail?: Img[]; headline?: string; eyebrow?: string;
  /** Optional film for the stage. The photograph becomes the poster. */
  video?: { src: string; type?: string } | null;
}
const { post, rail = [], headline, eyebrow, video = null } = Astro.props;
const title = headline?.trim() || post.title;
const label = eyebrow?.trim() || kicker(post);
const href = `/journal/${post.slug}/`;

const pool = unique([post.leadImage, ...rail]);
const stage = landscapeFirst(pool)[0] ?? null;
const sides = portraitFirst(unique(pool, stage)).slice(0, 6);
const left = sides.slice(0, 3);
const right = sides.slice(3, 6);
const shot = stage ? picture(stage) : null;
---
<section class="wrap stage" aria-labelledby="lead-title">
  <div class="stage__grid">
    <div class="stage__rail stage__rail--left" aria-hidden="true">
      {left.map((img) => <div class="stage__cell"><Plate image={img} ratio="3:4" sizes="(max-width: 640px) 33vw, 12vw" caption={false} loading="eager" /></div>)}
    </div>

    <div class="stage__main">
      <figure class="stage__plate">
        <a class="stage__frame" href={href} tabindex="-1" aria-hidden="true">
          {video && shot ? (
            <video class="stage__media" autoplay muted loop playsinline preload="metadata" poster={shot.src} data-stage-video>
              <source src={video.src} type={video.type ?? 'video/mp4'} />
            </video>
          ) : shot ? (
            <img class="stage__media" src={shot.src} srcset={shot.srcset} sizes={shot.srcset ? '(max-width: 640px) 100vw, 78vw' : undefined} width={shot.width} height={shot.height} alt="" loading="eager" fetchpriority="high" decoding="async" style={shot.objectPosition ? `object-position:${shot.objectPosition}` : undefined} />
          ) : (
            <span class="stage__empty"><span class="caption">Photograph to come</span></span>
          )}
        </a>
      </figure>
    </div>

    <div class="stage__rail stage__rail--right" aria-hidden="true">
      {right.map((img) => <div class="stage__cell"><Plate image={img} ratio="3:4" sizes="(max-width: 640px) 33vw, 12vw" caption={false} loading="eager" /></div>)}
    </div>
  </div>
  <div class="stage__text">
    <p class="eyebrow">{label}</p>
    <h1 id="lead-title" class="stage__title"><a href={href} class="stage__link">{title}</a></h1>
    <p class="standfirst stage__standfirst">{post.standfirst}</p>
    <TextLink href={href} class="stage__more">Read the story</TextLink>
  </div>
</section>

<style>
  .stage{padding-top:clamp(20px,2.6vw,36px)}
  /* The stage is held to half the viewport so the words beneath it clear the fold;
     its width follows from that at 16:9, never wider than the six-up geometry allows. */
  .stage__grid{--g:var(--grid-gap);--fit:calc((100% - var(--g)) * 32 / 41);--cap:calc(50vh * 16 / 9);--c:min(var(--fit),var(--cap));display:grid;grid-template-columns:minmax(0,1fr) var(--c) minmax(0,1fr);column-gap:var(--g);align-items:stretch}
  /* Side rails: three 3:4 cells share the stage's height and keep to the page's outer edges. */
  .stage__rail{display:grid;grid-template-rows:repeat(3,minmax(0,1fr));row-gap:var(--g);min-height:0}
  .stage__cell{min-height:0;display:flex}
  .stage__rail--right .stage__cell{justify-content:flex-end}
  .stage__cell :global(.plate){height:100%;max-width:100%}
  .stage__cell :global(.plate__frame){height:100%;width:auto;max-width:100%;aspect-ratio:3 / 4 !important}

  .stage__main{position:relative;min-width:0}
  .stage__plate{margin:0}
  .stage__frame{position:relative;display:block;aspect-ratio:16 / 9;overflow:hidden;background:var(--surface-sunken);border:0;text-decoration:none}
  .stage__media{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
  .stage__empty{position:absolute;inset:0;display:grid;place-items:center;background:var(--paper-100);box-shadow:inset 0 0 0 var(--hairline) var(--rule)}

  /* The words: one centred column beneath the stage, the same set as the other leads
     (eyebrow, headline, standfirst, link), on one axis with even spacing. */
  .stage__text{display:flex;flex-direction:column;align-items:center;gap:var(--space-4);margin:0 auto;padding:clamp(28px,3vw,48px) 0 var(--space-4);max-width:calc((100% - var(--grid-gap)) * 32 / 41);text-align:center}
  .stage__title{margin:0;font-family:var(--font-display);font-weight:var(--weight-display);font-size:clamp(2rem,3.4vw,4rem);line-height:1.04;letter-spacing:var(--track-display);text-wrap:balance}
  .stage__link{color:var(--ink);text-decoration:none;border:0;transition:color var(--dur-base) var(--ease-editorial)}
  .stage__link:hover{color:var(--ink-700)}
  .stage__standfirst{margin:0;max-width:52ch;font-size:var(--text-lede);text-wrap:pretty}
  .eyebrow{margin:0}
  .stage__text :global(.stage__more){align-self:center}
  @media (max-width:640px){.stage__text :global(.stage__more){align-self:flex-start}}

  @media (max-width:640px){
    .stage__grid{grid-template-columns:minmax(0,1fr);row-gap:var(--g)}
    .stage__main{order:1}
    .stage__rail--left{order:2;grid-template-rows:none;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:var(--g)}
    .stage__rail--right{display:none}
    .stage__cell :global(.plate__frame){height:auto;aspect-ratio:3 / 4 !important}
    .stage__text{padding:var(--space-4) 0 0;max-width:none;align-items:flex-start;text-align:left}
    .stage__title{font-size:var(--text-display-s)}
  }
</style>

<script>
  // A film on the stage holds still for readers who asked for reduced motion.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('[data-stage-video]').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
  }
</script>
