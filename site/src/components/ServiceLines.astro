---
/* The two service lines, side by side, divided by a vertical hairline. Each half:
   eyebrow, Zodiak headline, a short intro and the menu as a ruled price list —
   prices are copy, stated plainly and completely. */
import TextLink from './TextLink.astro';
import type { HomePage, ServicePackage } from '@/lib/sanity';

interface Props { home: HomePage; packages: ServicePackage[] }
const { home, packages } = Astro.props;
const lines = [
  { id: 'interiors', eyebrow: home.interiorsEyebrow, headline: home.interiorsHeadline, intro: home.interiorsIntro, items: packages.filter((p) => p.line === 'interiors') },
  { id: 'styling', eyebrow: home.stylingEyebrow, headline: home.stylingHeadline, intro: home.stylingIntro, items: packages.filter((p) => p.line === 'styling') },
];
---
<section class="wrap sl section-tight" aria-label="Services">
  <div class="rule-black"></div>
  <div class="sl__cols">
    {lines.map((l) => (
      <div class="sl__col reveal" id={l.id}>
        <p class="eyebrow">{l.eyebrow}</p>
        <h2 class="display-m sl__title">{l.headline}</h2>
        <p class="body sl__intro">{l.intro}</p>
        <dl class="sl__menu">
          {l.items.map((p) => (
            <div class="sl__row">
              <dt class="sl__name"><span class="numeral sl__num" aria-hidden="true">{p.numeral}</span><span class="label">{p.title}</span></dt>
              <dd class="sl__price">
                <span class="label">{p.price}</span>
                {p.priceNote && <span class="body-s sl__note">{p.priceNote}</span>}
              </dd>
            </div>
          ))}
        </dl>
        <TextLink href="/#inquire">Begin an inquiry</TextLink>
      </div>
    ))}
  </div>
</section>

<style>
  .sl__cols{display:grid;grid-template-columns:1fr 1fr;column-gap:0;padding-top:var(--space-6)}
  .sl__col{display:flex;flex-direction:column;gap:var(--space-5);padding-right:clamp(24px,4vw,72px);scroll-margin-top:80px}
  .sl__col + .sl__col{border-left:var(--hairline) solid var(--rule);padding-left:clamp(24px,4vw,72px);padding-right:0}
  .eyebrow{margin:0}
  .sl__title{margin:0;max-width:16ch;text-wrap:balance}
  .sl__intro{margin:0;max-width:46ch}
  .sl__menu{margin:var(--space-3) 0 var(--space-2);border-top:var(--hairline) solid var(--rule-black)}
  .sl__row{display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:var(--space-5);align-items:baseline;padding:var(--space-4) 0;border-bottom:var(--hairline) solid var(--rule)}
  .sl__name{display:flex;align-items:baseline;gap:var(--space-3);margin:0;color:var(--ink)}
  .sl__num{font-size:1.125rem}
  .sl__price{margin:0;text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:2px;color:var(--ink)}
  .sl__note{max-width:24ch;text-align:right;font-size:0.75rem;line-height:1.5}
  .label{font-size:var(--text-label-l)}
  @media (max-width:1024px){
    .sl__cols{grid-template-columns:1fr;row-gap:var(--space-8)}
    .sl__col{padding-right:0}
    .sl__col + .sl__col{border-left:0;padding-left:0;border-top:var(--hairline) solid var(--rule);padding-top:var(--space-7)}
  }
  @media (max-width:640px){
    .sl__row{grid-template-columns:1fr;row-gap:var(--space-2)}
    .sl__price{align-items:flex-start;text-align:left;padding-left:calc(1.125rem + var(--space-3))}
    .sl__note{text-align:left}
  }
</style>
