---
import Base from '@/layouts/Base.astro';
import LeadStory from '@/components/LeadStory.astro';
import StoryGrid from '@/components/StoryGrid.astro';
import ServiceGrid from '@/components/ServiceGrid.astro';
import ServiceCollage from '@/components/ServiceCollage.astro';
import SplitFeature from '@/components/SplitFeature.astro';
import StudioBlock from '@/components/StudioBlock.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import { getHome, getPosts } from '@/lib/sanity';

const { home, settings, packages } = await getHome();
const latest = home.latest.slice(0, 3);
const interiors = packages.filter((p) => p.line === 'interiors');
const styling = packages.filter((p) => p.line === 'styling');
// Rail for the wide-screen hero: real photographs from elsewhere on the site, newest stories first.
const posts = await getPosts();
const rail = [
  ...interiors.map((p) => p.image ?? null),
  ...posts.filter((p) => p._id !== home.leadStory._id).map((p) => p.leadImage),
  ...posts.flatMap((p) => p.body.filter((n: any) => n._type === 'imageBlock').map((n: any) => n.image)),
  home.studioPortrait,
].filter((i): i is NonNullable<typeof i> => Boolean(i));
---
<Base settings={settings} image={home.leadStory.leadImage ?? home.studioPortrait}>
  <LeadStory post={home.leadStory} rail={rail} />
  <StoryGrid posts={latest} title="The latest" moreHref="/journal/" uniform />
  <ServiceCollage id="interiors" eyebrow={home.interiorsEyebrow} headline={home.interiorsHeadline} intro={home.interiorsIntro} packages={interiors} />
  <ServiceGrid id="styling" eyebrow={home.stylingEyebrow} headline={home.stylingHeadline} intro={home.stylingIntro} packages={styling} />
  <SplitFeature post={home.featuredPost} />
  <StudioBlock home={home} />
  <InquiryForm home={home} />
</Base>
