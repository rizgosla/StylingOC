---
import Base from '@/layouts/Base.astro';
import LeadStory from '@/components/LeadStory.astro';
import StoryGrid from '@/components/StoryGrid.astro';
import ServiceSection from '@/components/ServiceSection.astro';
import SplitFeature from '@/components/SplitFeature.astro';
import StudioBlock from '@/components/StudioBlock.astro';
import InquiryCta from '@/components/InquiryCta.astro';
import { getHome } from '@/lib/sanity';

const { home, settings, packages } = await getHome();
const latest = home.latest.slice(0, 3);
const interiors = packages.filter((p) => p.line === 'interiors');
const styling = packages.filter((p) => p.line === 'styling');
---
<Base settings={settings} image={home.leadStory.leadImage ?? home.studioPortrait}>
  <LeadStory post={home.leadStory} />
  <StoryGrid posts={latest} title="The latest" moreHref="/journal/" />
  <ServiceSection id="interiors" eyebrow={home.interiorsEyebrow} headline={home.interiorsHeadline} intro={home.interiorsIntro} image={home.interiorsImage} packages={interiors} />
  <SplitFeature post={home.featuredPost} />
  <ServiceSection id="styling" eyebrow={home.stylingEyebrow} headline={home.stylingHeadline} intro={home.stylingIntro} image={home.stylingImage} packages={styling} flip />
  <StudioBlock home={home} />
  <InquiryCta home={home} />
</Base>
