---
import Base from '@/layouts/Base.astro';
import LeadStory from '@/components/LeadStory.astro';
import StoryGrid from '@/components/StoryGrid.astro';
import ServiceList from '@/components/ServiceList.astro';
import SplitFeature from '@/components/SplitFeature.astro';
import PullQuote from '@/components/PullQuote.astro';
import StudioBlock from '@/components/StudioBlock.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import { getHome, getPosts } from '@/lib/sanity';

const { home, settings, packages } = await getHome();
const latest = home.latest.slice(0, 3);
const rail = (await getPosts()).filter((p) => p._id !== home.leadStory._id);
const interiors = packages.filter((p) => p.line === 'interiors');
const styling = packages.filter((p) => p.line === 'styling');
---
<Base settings={settings} image={home.leadStory.leadImage ?? home.studioPortrait}>
  <LeadStory post={home.leadStory} rail={rail} />
  <StoryGrid posts={latest} title="The latest" moreHref="/journal/" stagger />
  <ServiceList id="interiors" eyebrow={home.interiorsEyebrow} headline={home.interiorsHeadline} intro={home.interiorsIntro} packages={interiors} />
  <ServiceList id="styling" eyebrow={home.stylingEyebrow} headline={home.stylingHeadline} intro={home.stylingIntro} packages={styling} />
  <SplitFeature post={home.featuredPost} />
  <PullQuote quote={home.testimonial.quote} attribution={home.testimonial.attribution} role={home.testimonial.role} />
  <StudioBlock home={home} />
  <InquiryForm home={home} />
</Base>
