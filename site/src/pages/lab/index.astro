---
/* Prototype index: the hero layouts under consideration. Not indexed, not linked. */
import Base from '@/layouts/Base.astro';
import { getHome } from '@/lib/sanity';
import { heroVariants } from '@/lib/labHero';

const { settings } = await getHome();
---
<Base settings={settings} title="Lab: hero layouts" noindex>
  <section class="wrap section-tight">
    <div class="rule-black"></div>
    <div class="ix__head">
      <p class="eyebrow">Lab</p>
      <h1 class="display-m ix__title">Two ways to set the lead</h1>
      <p class="body ix__lede">The present hero bottom-aligns the words beside a tall plate, which leaves a block of white above the headline. Each page below is the full home page with a different lead in place; the strip at the top flips between them.</p>
    </div>
    <ol class="ix__list">
      {heroVariants.map((v, i) => (
        <li class="ix__item">
          <span class="numeral" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="ix__body">
            <h2 class="display-s ix__name"><a class="ix__link" href={`/lab/hero-${v.key}/`}>{v.key.toUpperCase()} · {v.name}</a></h2>
            <p class="body-s ix__note">{v.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .ix__head{display:flex;flex-direction:column;gap:var(--space-4);padding:var(--space-6) 0 var(--space-7)}
  .ix__title,.ix__lede,.eyebrow{margin:0}
  .ix__lede{max-width:56ch}
  .ix__list{display:flex;flex-direction:column}
  .ix__item{display:grid;grid-template-columns:4rem minmax(0,1fr);gap:var(--space-4);align-items:baseline;padding:var(--space-5) 0;border-top:var(--hairline) solid var(--rule)}
  .ix__body{display:flex;flex-direction:column;gap:var(--space-2)}
  .ix__name{margin:0}
  .ix__link{color:var(--ink);text-decoration:none;border:0}
  .ix__link:hover{color:var(--accent-strong)}
  .ix__note{margin:0;max-width:64ch}
</style>
