---
import Base from '@/layouts/Base.astro';
import Plate from '@/components/Plate.astro';
import PortableText from '@/components/portable-text/PortableText.astro';
import StoryGrid from '@/components/StoryGrid.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import { getHome, getPosts, getRelated, formatDate, kicker, LAYOUT_EYEBROW } from '@/lib/sanity';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { home, settings } = await getHome();
const related = await getRelated(post.slug, 3);
const isoDate = post.publishedAt.length === 10 ? `${post.publishedAt}T12:00:00Z` : post.publishedAt;
const portrait = Boolean(post.leadImage && post.leadImage.height > post.leadImage.width);

const layout = post.layout ?? 'feature';
/* The department label opens the eyebrow; a named interviewee finishes the phrase. */
const department = layout === 'interview' && post.interviewee
  ? `In conversation with ${post.interviewee}`
  : LAYOUT_EYEBROW[layout];
const eyebrow = [department, kicker(post)].filter(Boolean).join(' · ');
/* Interview sets its portrait beside the title; the note sets its plate beside the text.
   Everything else keeps the shipped header-then-plate opener. */
const leadInHeader = layout === 'interview';
const leadInBody = layout === 'note';
const leadBelowRule = !leadInHeader && !leadInBody;
---
<Base settings={settings} title={post.title} description={post.standfirst} image={post.leadImage} type="article" noindex={Boolean(post.draftNote)}>
  <article class:list={['post', `post--${layout}`]}>
    <header class="wrap post__head">
      <div class="grid">
        {leadInHeader && (
          <div class="post__headplate">
            <Plate image={post.leadImage} ratio="3:4" sizes="(max-width:1024px) 100vw, 22vw" loading="eager" fetchpriority="high" />
          </div>
        )}
        <div class="post__headin">
          <p class="eyebrow">{eyebrow} · <time datetime={isoDate}>{formatDate(post.publishedAt)}</time></p>
          <h1 class:list={[layout === 'note' ? 'display-m' : 'display-l', 'post__title']}>{post.title}</h1>
          <p class="standfirst post__standfirst">{post.standfirst}</p>
          <p class="caption post__byline">Styling OC{post.photoCredit ? ` · ${post.photoCredit}` : ''}</p>
          {post.draftNote && <p class="eyebrow post__draft">Draft — for client review</p>}
        </div>
      </div>
      <div class="rule-black"></div>
    </header>

    {leadBelowRule && (
      <div class="wrap post__lead">
        {layout === 'essay' ? (
          <Plate image={post.leadImage} ratio={post.leadImage ? 'natural' : '3:2'} sizes="100vw" loading="eager" fetchpriority="high" maxHeight={portrait ? '86vh' : undefined} fit={portrait ? 'height' : 'width'} />
        ) : (
          <Plate image={post.leadImage} ratio={post.leadImage ? 'natural' : '3:2'} sizes={portrait ? '(max-width: 640px) 100vw, 70vh' : '(max-width: 1600px) 100vw, 1560px'} loading="eager" fetchpriority="high" maxHeight={portrait ? '86vh' : '80vh'} fit={portrait ? 'height' : 'width'} />
        )}
      </div>
    )}

    <div class="wrap">
      <div class="grid">
        {leadInBody && (
          <div class="post__noteplate">
            <Plate image={post.leadImage} ratio="4:5" sizes="(max-width:1024px) 100vw, 30vw" loading="eager" fetchpriority="high" />
          </div>
        )}
        <div class="post__body">
          <PortableText value={post.body} layout={layout} interviewee={post.interviewee} />
          {layout === 'interview' && post.signoff && <p class="italic post__signoff">{post.signoff}</p>}
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && <StoryGrid posts={related} title="More stories" moreHref="/journal/" numbered={false} closing />}
  <InquiryForm home={home} email={settings.email} phone={settings.phone} />
</Base>

<style>
  /* The journal's own type scale. Scoped to the article so the home page and the
     global tokens are untouched: a wide column wants a bigger body than a 64ch one. */
  .post{
    --post-body:clamp(1.0625rem,0.95rem + 0.35vw,1.3125rem);   /* 17px → 21px at 1900 */
    --post-lead:clamp(1.25rem,1.1rem + 0.5vw,1.625rem);
    --post-label:var(--text-label-l);                          /* 11px — never 9px in a body */
  }

  .post__head{padding-top:clamp(28px,4vw,56px)}
  .post__headin{grid-column:2 / span 10;display:flex;flex-direction:column;gap:var(--space-5);padding-bottom:var(--space-7)}
  .eyebrow{margin:0}
  .post__title{margin:0;max-width:22ch;text-wrap:balance}
  .post__standfirst{margin:0;max-width:44ch;font-size:var(--post-lead);line-height:1.5}
  .post__byline{margin:0}
  .post__draft{margin:0}
  /* One wide column for every layout: ten of the twelve, indented by one. */
  .post__body{grid-column:2 / span 10;padding-top:var(--section-y-tight);padding-bottom:var(--space-6)}

  /* Interview: the portrait sits beside the title stack, never behind it. */
  .post--interview .post__headplate{grid-column:1 / span 3}
  .post--interview .post__headin{grid-column:5 / span 8}
  .post__signoff{margin:var(--space-7) 0 0;font-size:var(--post-body);color:var(--ink-muted)}

  /* Note: the only layout that keeps a split — its plate holds the left four. */
  .post--note .post__headin{padding-bottom:var(--space-6)}
  .post--note .post__noteplate{grid-column:1 / span 4;padding-top:var(--section-y-tight)}
  .post--note .post__body{grid-column:6 / span 7}

  @media (max-width:1024px){
    .post__headin{grid-column:1 / span 7}
    .post__body{grid-column:1 / -1}
    /* The split header stacks: the portrait runs full width above the title stack,
       cropped to a band so the headline is not pushed a screen and a half down. */
    .post--interview .post__headplate,.post--interview .post__headin{grid-column:1 / -1}
    .post--interview .post__headplate :global(.plate__frame){max-height:56vh}
    /* Every split stacks at tablet: the note's plate runs full width above its column. */
    .post--note .post__noteplate,.post--note .post__body{grid-column:1 / -1}
  }
  @media (max-width:640px){
    .post__headin,.post__body{grid-column:1 / -1}
    .post--interview .post__headplate,.post--note .post__noteplate{grid-column:1 / -1}
    .post--interview .post__headin,.post--note .post__body{grid-column:1 / -1}
    .post--note .post__noteplate{padding-top:var(--space-6)}
  }
</style>
