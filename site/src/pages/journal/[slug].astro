---
import Base from '@/layouts/Base.astro';
import Plate from '@/components/Plate.astro';
import PortableText from '@/components/portable-text/PortableText.astro';
import StoryGrid from '@/components/StoryGrid.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import { getHome, getPosts, getRelated, formatDate, kicker, CATEGORY_LABEL, LAYOUT_EYEBROW } from '@/lib/sanity';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { home, settings } = await getHome();
const related = await getRelated(post.slug, 3);
const isoDate = post.publishedAt.length === 10 ? `${post.publishedAt}T12:00:00Z` : post.publishedAt;

const layout = post.layout ?? 'feature';
/* The department label opens the kicker; a named interviewee finishes the phrase.
   A feature has no department, so it names its category and its place instead. */
const department = layout === 'interview' && post.interviewee
  ? `In conversation with ${post.interviewee}`
  : LAYOUT_EYEBROW[layout];
const kickerText = department
  ? [department, CATEGORY_LABEL[post.category] ?? post.category].filter(Boolean).join(' · ')
  : kicker(post);
/* The byline says "Photography by" itself, so a credit that already says so is trimmed. */
const credit = post.photoCredit?.replace(/^photography\s+(?:courtesy\s+of|by)\s+/i, '').trim();
---
<Base settings={settings} title={post.title} description={post.standfirst} image={post.leadImage} type="article" noindex={Boolean(post.draftNote)}>
  <article class:list={['post', `post--${layout}`]}>
    {/* The opening spread: type on white on the left, the photograph bled to the right
        edge of the screen. One opener for every layout — the body below does the varying. */}
    <section class="post__opener">
      <div class="post__stack">
        <p class="eyebrow post__kicker">{kickerText}</p>
        <h1 class="post__title">{post.title}</h1>
        <p class="post__dek">{post.standfirst}</p>
        <p class="post__by">By Styling OC{credit && (<><br />Photography by {credit}</>)}</p>
        <time class="post__date" datetime={isoDate}>{formatDate(post.publishedAt)}</time>
        {post.draftNote && <p class="eyebrow post__draft">Draft — for client review</p>}
      </div>
      <div class="post__plate">
        <Plate image={post.leadImage} fill loading="eager" fetchpriority="high" sizes="50vw" caption={false} />
      </div>
    </section>
    <div class="wrap"><div class="rule"></div></div>

    <div class="wrap">
      <div class="grid">
        <div class="post__body">
          <PortableText value={post.body} layout={layout} interviewee={post.interviewee} />
          {layout === 'interview' && post.signoff && <p class="italic post__signoff">{post.signoff}</p>}
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && <StoryGrid posts={related} title="More stories" moreHref="/journal/" numbered={false} closing />}
  <InquiryForm home={home} email={settings.email} phone={settings.phone} />
</Base>

<style>
  /* The opening spread is not inside .wrap: the photograph has to reach the screen edge. */
  .post__opener{display:grid;grid-template-columns:1fr 1fr;min-height:min(86vh,1000px)}
  .post__stack{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:var(--space-9) clamp(24px,8vw,160px);gap:0}
  .post__kicker{margin:0 0 var(--space-4);font-size:var(--text-label-l)}
  .post__title{margin:0;font-family:var(--font-display);font-weight:var(--weight-display);font-size:clamp(2rem,2.4vw,2.875rem);line-height:1.15;letter-spacing:-0.01em;color:var(--ink);max-width:22ch;text-wrap:balance}
  /* Sentence case and small, like AD's dek — never the all-caps .standfirst. */
  .post__dek{margin:var(--space-4) 0 0;font-family:var(--font-body);font-size:0.9375rem;line-height:1.5;color:var(--ink);max-width:46ch;text-transform:none;letter-spacing:0}
  .post__by{margin:var(--space-5) 0 0;font-family:var(--font-body);font-size:0.75rem;line-height:1.6;color:var(--ink)}
  .post__date{display:block;margin-top:var(--space-3);font-family:var(--font-body);font-size:0.75rem;color:var(--ink-muted)}
  .post__draft{margin-top:var(--space-4);font-size:var(--text-label-l)}
  .post__plate{position:relative;min-height:60vh}

  /* One centred column for every layout: eight of the twelve, two clear on each side. */
  .post__body{grid-column:3 / span 8;padding-top:var(--section-y-tight);padding-bottom:var(--space-6)}
  .post__signoff{margin:var(--space-7) 0 0;font-size:1.0625rem;color:var(--ink-muted)}

  @media (max-width:1024px){
    /* The spread stacks: words first, then the photograph at a portrait crop. */
    .post__opener{grid-template-columns:1fr;min-height:0}
    .post__stack{padding:var(--space-8) var(--gutter)}
    .post__plate{min-height:0}
    .post__plate :global(.plate--fill){height:auto}
    .post__plate :global(.plate--fill .plate__frame){position:relative;inset:auto;height:auto;aspect-ratio:4 / 5}
    .post__body{grid-column:1 / -1}
  }
  @media (max-width:640px){
    .post__stack{padding:var(--space-7) var(--gutter)}
  }
</style>
