---
import Base from '@/layouts/Base.astro';
import StoryGrid from '@/components/StoryGrid.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import { getHome, getPosts } from '@/lib/sanity';

const { home, settings } = await getHome();
const posts = await getPosts();
const rows: typeof posts[] = [];
for (let i = 0; i < posts.length; i += 3) rows.push(posts.slice(i, i + 3));
---
<Base settings={settings} title="Journal" description="Stories from Styling OC: interiors, personal styling and the studio, from Orange County.">
  <section class="wrap jh">
    <p class="eyebrow">Journal</p>
    <h1 class="display-l jh__title">Stories from the studio.</h1>
    <p class="standfirst jh__standfirst">Interiors · Personal styling · Orange County</p>
  </section>
  {rows.map((row, i) => (
    <StoryGrid posts={row} title={i === 0 ? "All stories" : ""} numbered={false} headingLevel="h2" closing={i === rows.length - 1} />
  ))}
  <InquiryForm home={home} email={settings.email} phone={settings.phone} />
</Base>

<style>
  .jh{padding-top:clamp(28px,4vw,56px);display:flex;flex-direction:column;gap:var(--space-5)}
  .jh__title{margin:0;max-width:14ch}
  .jh__standfirst{margin:0}
  .eyebrow{margin:0}
</style>
