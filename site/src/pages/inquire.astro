---
import Base from '@/layouts/Base.astro';
import IntakeForm from '@/components/IntakeForm.astro';
import { getHome } from '@/lib/sanity';

const { home, settings } = await getHome();
---
<Base settings={settings} title="Inquire" description="Begin an inquiry with Styling OC: interior design and personal styling in Orange County. Tell us about your space or your wardrobe and we will reply personally.">
  <section class="wrap iq">
    <div class="grid iq__grid">
      <div class="iq__intro">
        <p class="eyebrow">{home.inquiryEyebrow}</p>
        <h1 class="display-l iq__title">{home.inquiryHeadline}</h1>
        {home.inquiryIntro && <p class="body iq__lede">{home.inquiryIntro}</p>}
        <dl class="iq__facts">
          <div><dt class="eyebrow eyebrow--muted">Studio</dt><dd class="body-s">{settings.location}</dd></div>
          {settings.email && <div><dt class="eyebrow eyebrow--muted">Email</dt><dd class="body-s"><a href={`mailto:${settings.email}`}>{settings.email}</a></dd></div>}
          {settings.phone && <div><dt class="eyebrow eyebrow--muted">Phone</dt><dd class="body-s"><a href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`}>{settings.phone}</a></dd></div>}
        </dl>
      </div>
      <div class="iq__form">
        <IntakeForm home={home} />
      </div>
    </div>
  </section>
</Base>

<style>
  .iq{padding-top:clamp(28px,4vw,56px)}
  .iq__grid{align-items:start}
  .iq__intro{grid-column:1 / span 4;display:flex;flex-direction:column;gap:var(--space-5);position:sticky;top:88px}
  .eyebrow{margin:0}
  .iq__title{margin:0;max-width:12ch;text-wrap:balance}
  .iq__lede{margin:0;max-width:40ch}
  .iq__facts{display:flex;flex-direction:column;gap:var(--space-4);margin:var(--space-4) 0 0;padding-top:var(--space-5);border-top:var(--hairline) solid var(--rule);max-width:40ch}
  .iq__facts div{display:flex;flex-direction:column;gap:var(--space-1)}
  .iq__facts dd{margin:0}
  .iq__facts a{color:var(--ink);border-bottom:var(--hairline) solid var(--rule-strong)}
  .iq__form{grid-column:6 / span 7}
  @media (max-width:1024px){
    .iq__intro{grid-column:1 / span 3;position:static}
    .iq__form{grid-column:4 / span 5}
  }
  @media (max-width:640px){
    .iq__intro,.iq__form{grid-column:1 / -1}
  }
</style>
