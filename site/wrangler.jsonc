{
  // Cloudflare Workers deploy (Workers & Pages → Create → connect this repo, root "site").
  // The Astro build in ./dist is served as static assets; the Worker in ./worker only
  // handles POST /api/inquiry, everything else falls through to the assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stylingoc",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
