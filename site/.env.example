# Copy to .env — never commit .env
# Sanity (from https://www.sanity.io/manage). Leave PUBLIC_SANITY_PROJECT_ID empty to
# render the site from the local seed content in sanity/seed/content.ts.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Editor token with write access — used ONLY by `npm run seed` and the Cloudflare
# Pages function that stores inquiries. Set it in Cloudflare as a secret, not here.
SANITY_WRITE_TOKEN=
# Canonical site URL (used for OpenGraph and the sitemap)
PUBLIC_SITE_URL=https://stylingoc.pages.dev
