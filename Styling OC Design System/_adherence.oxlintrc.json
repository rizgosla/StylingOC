{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/editorial/**",
              "components/forms/**",
              "components/navigation/**",
              "components/projects/**",
              "components/services/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Zodiak|Archivo))/i]",
        "message": "Font not provided by the design system. Available: Zodiak, Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='BeforeAfter'] > JSXAttribute > JSXIdentifier[name!=/^(?:before|after|beforeLabel|afterLabel|caption|initial|ratio|key|ref|className|style|children)$/]",
        "message": "<BeforeAfter> doesn't accept that prop. Declared props: before, after, beforeLabel, afterLabel, caption, initial, ratio."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|variant|size|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, href, variant, size, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|accent|onImage)$/]",
        "message": "<Button> variant must be one of 'outline' | 'solid' | 'accent' | 'onImage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroMeta'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<HeroMeta> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|numeral|rule|tone|as|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, numeral, rule, tone, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|ink|muted|inverse)$/]",
        "message": "<Eyebrow> tone must be one of 'accent' | 'ink' | 'muted' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Portrait'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|key|ref|className|style|children)$/]",
        "message": "<Portrait> doesn't accept that prop. Declared props: src, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='InquiryField'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|type|placeholder|options|rows|required|span|key|ref|className|style|children)$/]",
        "message": "<InquiryField> doesn't accept that prop. Declared props: name, label, type, placeholder, options, rows, required, span."
      },
      {
        "selector": "JSXOpeningElement[name.name='InquiryField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel|textarea|select)$/]",
        "message": "<InquiryField> type must be one of 'text' | 'email' | 'tel' | 'textarea' | 'select'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageAlt|name|location|scope|href|ratio|numeral|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: image, imageAlt, name, location, scope, href, ratio, numeral."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectIndex'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|projects|columns|offsets|footer|key|ref|className|style|children)$/]",
        "message": "<ProjectIndex> doesn't accept that prop. Declared props: eyebrow, title, projects, columns, offsets, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|attribution|role|tone|align|size|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: quote, attribution, role, tone, align, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:day|night)$/]",
        "message": "<PullQuote> tone must be one of 'day' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<PullQuote> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<PullQuote> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceMenu'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lede|columns|tone|children|key|ref|className|style|children)$/]",
        "message": "<ServiceMenu> doesn't accept that prop. Declared props: eyebrow, title, lede, columns, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceMenu'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:day|night)$/]",
        "message": "<ServiceMenu> tone must be one of 'day' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceTier'] > JSXAttribute > JSXIdentifier[name!=/^(?:numeral|title|items|price|priceNote|note|image|imageAlt|tone|layout|key|ref|className|style|children)$/]",
        "message": "<ServiceTier> doesn't accept that prop. Declared props: numeral, title, items, price, priceNote, note, image, imageAlt, tone, layout."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceTier'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:day|night)$/]",
        "message": "<ServiceTier> tone must be one of 'day' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceTier'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:panel|row|withImage)$/]",
        "message": "<ServiceTier> layout must be one of 'panel' | 'row' | 'withImage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<FooterItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitFeature'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageAlt|eyebrow|numeral|title|body|caption|action|imageSide|offset|ratio|key|ref|className|style|children)$/]",
        "message": "<SplitFeature> doesn't accept that prop. Declared props: image, imageAlt, eyebrow, numeral, title, body, caption, action, imageSide, offset, ratio."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitFeature'] > JSXAttribute[name.name='imageSide'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<SplitFeature> imageSide must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitFeature'] > JSXAttribute[name.name='offset'] > Literal[value!=/^(?:top|center|bottom)$/]",
        "message": "<SplitFeature> offset must be one of 'top' | 'center' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|tone|caps|style|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, tone, caps, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|accent|inverse)$/]",
        "message": "<TextLink> tone must be one of 'ink' | 'accent' | 'inverse'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
